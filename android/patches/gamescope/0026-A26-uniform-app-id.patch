A26 — one uniform app id for every window

GAMENATIVE_ROOT_DESKTOP=1 (wine's root desktop, set by the app) turns the
override off: both sites keep upstream's appID = X window id. The helper
that reads the variable lives here so that A33 and A48 can use it too.
Unset or any other value keeps the uniform id.

diff --git a/src/steamcompmgr.cpp b/src/steamcompmgr.cpp
index 8eb47a4..cd305bb 100644
--- a/src/steamcompmgr.cpp
+++ b/src/steamcompmgr.cpp
@@ -1547,6 +1547,29 @@ bool steamcompmgr_window_should_refresh_switch( steamcompmgr_win_t *w )
 #define SCREEN_SCALE_PROP	"STEAM_SCREEN_SCALE"
 #define SCREEN_MAGNIFICATION_PROP	"STEAM_SCREEN_MAGNIFICATION"
 
+// GameNative: every game in a session gets ONE uniform app id, regardless of
+// the store it came from (Steam/GOG/Epic/custom). Without --steam, gamescope
+// otherwise derives w->appID from the Xwayland window id (map_win/add_win
+// below) -- a per-launch value the app process cannot know, since the
+// gamescope_control client that calls request_app_performance_stats() lives in
+// the app process with no X11 connection. The requested id keys
+// wlserver.app_perf_requests, which wlserver_app_presented() matches against
+// w->appID (published on the base plane); a fixed id makes both sides agree
+// with no cross-process channel and no file I/O. The app side (GameNative
+// GameNativeDrm.GAMESCOPE_APP_ID) must use the same value.
+static constexpr uint32_t kGameNativeUniformAppId = 1;
+
+// GameNative: GAMENATIVE_ROOT_DESKTOP=1 says the guest runs on wine's root
+// desktop (explorer /desktop=root): every game window is a managed top-level X
+// window, as upstream expects. The patches written for wine's virtual desktop
+// (this uniform app id, A33's blank, A48's bring-to-front) then stand down.
+// Unset or any other value keeps them active. Read once, at startup.
+static const bool g_bGameNativeRootDesktop = []
+{
+	const char *pszRootDesktop = getenv( "GAMENATIVE_ROOT_DESKTOP" );
+	return pszRootDesktop != nullptr && strcmp( pszRootDesktop, "1" ) == 0;
+}();
+
 #define TRANSLUCENT	0x00000000
 #define OPAQUE		0xffffffff
 
@@ -5817,7 +5840,7 @@ map_win(xwayland_ctx_t* ctx, Window id, unsigned long sequence)
 	}
 	else
 	{
-		w->appID = w->xwayland().id;
+		w->appID = g_bGameNativeRootDesktop ? w->xwayland().id : kGameNativeUniformAppId;
 	}
 
 	if ( w->isSteamLegacyBigPicture )
@@ -6048,7 +6071,7 @@ add_win(xwayland_ctx_t *ctx, Window id, Window prev, unsigned long sequence)
 	}
 	else
 	{
-		new_win->appID = id;
+		new_win->appID = g_bGameNativeRootDesktop ? id : kGameNativeUniformAppId;
 	}
 
 	if ( new_win->isExternalOverlay )
