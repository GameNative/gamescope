+# gamenative A21: glm is a tracked git submodule (third_party/glm); it is
+# header-only, so depend on its include dir directly instead of resolving
+# the wrap (the wrap's meson.build overlay is not part of the submodule).
+# Lives outside subprojects/ because meson treats that tree as reserved
+# for wrap-resolved subprojects (sandbox violation warning otherwise).
+glm_dep = declare_dependency(
+  include_directories: include_directories('third_party/glm'),
+)
