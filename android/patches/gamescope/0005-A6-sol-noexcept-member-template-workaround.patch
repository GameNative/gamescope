+++ b/thirdparty/sol/sol.hpp
@@ -19679,7 +19679,7 @@ namespace sol { namespace function_detail {
 		}
 
 		template <bool is_yielding, bool no_trampoline>
-		static int call(lua_State* L) noexcept(std::is_nothrow_copy_assignable_v<T>) {
+		static int call(lua_State* L) noexcept /* gamenative A6: NDK clang substitutes trait-in-noexcept of member template */ {
 			int nr;
 			if constexpr (no_trampoline) {
 				nr = real_call(L);
@@ -19719,7 +19719,7 @@ namespace sol { namespace function_detail {
