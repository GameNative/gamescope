-static bool wait_xwayland_server_ready( gamescope_xwayland_server_t *pServer, size_t uIndex )
+// gamenative (A58): how a ready-wait ended. A child that dies before its
+// -displayfd write is a distinct outcome from one that stalls: wlroots reaps it
+// at once (xserver_handle_ready sees the pipe hang up, "Xwayland startup
+// failed"), tears its sockets down and leaves display == -1, but emits no
+// signal, so without this the wait would sit out the whole deadline on a corpse.
+enum class XWaylandStart
+{
+	Ready,
+	Exited,
+	Stalled,
+	Error,
+};
+
+static XWaylandStart wait_xwayland_server_ready( gamescope_xwayland_server_t *pServer, size_t uIndex )
 {
 	const auto start = std::chrono::steady_clock::now();
 
@@ -2368,7 +2382,16 @@ static bool wait_xwayland_server_ready( gamescope_xwayland_server_t *pServer, si
