 		{
 			wl_log.errorf( "wl_event_loop_dispatch failed\n" );
-			return false;
+			return XWaylandStart::Error;
+		}
+
+		if ( pServer->has_xwayland_exited() )
+		{
+			const auto elapsedMs = std::chrono::duration_cast<std::chrono::milliseconds>(
+				std::chrono::steady_clock::now() - start ).count();
+			wl_log.errorf( "Xwayland server %zu exited after %lld ms, before it signalled ready (no -displayfd write)\n",
+				uIndex, (long long)elapsedMs );
+			return XWaylandStart::Exited;
 		}
 
 		const auto elapsedMs = std::chrono::duration_cast<std::chrono::milliseconds>(
@@ -2381,11 +2404,58 @@ static bool wait_xwayland_server_ready( gamescope_xwayland_server_t *pServer, si
 				"loop was still dispatching requests throughout.\n",
