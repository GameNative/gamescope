-	return true;
+	return XWaylandStart::Ready;
+}
+
+// gamenative (A58): a base server that does not come up is tried once more with
+// glamor off. Xwayland's glamor runs on the payload's zink over the guest Vulkan
+// driver; where that EGL bring-up dies (an abort in the driver at make-current
+// has been seen on an Adreno 750) or wedges (the system driver on non-Adreno),
+// Xwayland never reaches its -displayfd write and the whole session fails,
+// although the server itself is fine without glamor: every Vulkan guest presents
+// through the WSI shim, and Xwayland falls back to software rendering when it is
+// told so (XWAYLAND_NO_GLAMOR, the switch the app already sets on non-Adreno).
+// The retry is one attempt, only for the servers created at init, and only when
+// glamor was on for the failed attempt.
+static XWaylandStart start_xwayland_server_with_fallback( size_t uIndex )
+{
+	XWaylandStart eResult = wait_xwayland_server_ready( wlserver.wlr.xwayland_servers[uIndex].get(), uIndex );
+	if ( eResult == XWaylandStart::Ready || eResult == XWaylandStart::Error )
+		return eResult;
+
+	const char *pszNoGlamor = getenv( "XWAYLAND_NO_GLAMOR" );
+	if ( pszNoGlamor && *pszNoGlamor )
+		return eResult;
+
+	wl_log.errorf( "Xwayland server %zu %s with glamor on; retrying once with XWAYLAND_NO_GLAMOR=1 (software rendering for X drawing; Vulkan guests present through the WSI shim regardless)\n",
+		uIndex, eResult == XWaylandStart::Exited ? "exited during startup" : "stalled during startup" );
+
+	if ( eResult == XWaylandStart::Stalled )
+	{
+		// wlroots never kills the child: it closes its end of the wl/wm fds
+		// and expects the server to die of the broken pipe. A child wedged in
+		// its driver does not read them, so end it ourselves before a second
+		// one binds the same display.
+		pid_t pid = wlserver.wlr.xwayland_servers[uIndex]->get_pid();
+		if ( pid > 0 )
+			kill( pid, SIGKILL );
+	}
+
+	setenv( "XWAYLAND_NO_GLAMOR", "1", 1 );
+	// Destroying the old server first: its wlroots half unlinks and closes the
+	// X sockets, so the replacement binds the same display number again, and
+	// nothing else in gamescope holds a pointer to a base server yet.
+	wlserver.wlr.xwayland_servers[uIndex].reset();
+	wlserver.wlr.xwayland_servers[uIndex] = std::make_unique<gamescope_xwayland_server_t>( wlserver.display, (int)uIndex );
+
+	eResult = wait_xwayland_server_ready( wlserver.wlr.xwayland_servers[uIndex].get(), uIndex );
+	if ( eResult == XWaylandStart::Ready )
+		wl_log.infof( "Xwayland server %zu is up with glamor off\n", uIndex );
+	return eResult;
 }
 
