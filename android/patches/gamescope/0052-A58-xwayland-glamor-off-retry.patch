-		if ( !wait_xwayland_server_ready( wlserver.wlr.xwayland_servers[i].get(), i ) )
+		if ( start_xwayland_server_with_fallback( i ) != XWaylandStart::Ready )
 			return false;
 	}
 
@@ -3766,6 +3836,14 @@ bool gamescope_xwayland_server_t::is_xwayland_ready() const
