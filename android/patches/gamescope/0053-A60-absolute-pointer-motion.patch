+// A position on the output, 0..1 on each axis, from a pointer that reports
+// positions and not steps (the host's touchscreen, through the virtual
+// pointer). It reaches the focused window as a touch does, so the cursor lands
+// where the picture was touched whatever the window's size and place.
+void wlserver_mouseabsolute( double x, double y, uint32_t time )
+{
+	assert( wlserver_is_lock_held() );
+
+	if ( wlserver.mouse_focus_surface == NULL )
+		return;
+
+	double tx = ( x * g_nOutputWidth + focusedWindowOffsetX ) * focusedWindowScaleX;
+	double ty = ( y * g_nOutputHeight + focusedWindowOffsetY ) * focusedWindowScaleY;
+
+	auto [nWidth, nHeight] = wlserver_get_cursor_bounds();
+	tx = std::clamp( tx, 0.0, std::max( nWidth - 0.1, 0.0 ) );
+	ty = std::clamp( ty, 0.0, std::max( nHeight - 0.1, 0.0 ) );
+
+	// A game that locked the pointer reads steps and the cursor does not move:
+	// its step is the one from the last position, not the one from the cursor.
+	static double s_flLastX = 0.0, s_flLastY = 0.0;
+	static bool s_bHaveLast = false;
+
+	struct wlr_pointer_constraint_v1 *pConstraint = wlserver.GetCursorConstraint();
+	bool bLocked = pConstraint && pConstraint->type == WLR_POINTER_CONSTRAINT_V1_LOCKED;
+
+	double dx = tx - ( bLocked ? s_flLastX : wlserver.mouse_surface_cursorx );
+	double dy = ty - ( bLocked ? s_flLastY : wlserver.mouse_surface_cursory );
+	if ( bLocked && !s_bHaveLast )
+		dx = dy = 0.0;
+
+	s_flLastX = tx;
+	s_flLastY = ty;
+	s_bHaveLast = true;
+
+	wlserver_perform_rel_pointer_motion( dx, dy );
+
+	if ( !wlserver_apply_constraint( &dx, &dy ) )
+	{
+		wlr_seat_pointer_notify_frame( wlserver.wlr.seat );
+		return;
+	}
+
+	wlserver_mousewarp( wlserver.mouse_surface_cursorx + dx, wlserver.mouse_surface_cursory + dy, time, false );
+}
