index 773e95c..fca0913 100644
--- a/src/steamcompmgr.cpp
+++ b/src/steamcompmgr.cpp
@@ -1233,6 +1233,128 @@ uint32_t g_uCurrentBasePlaneAppID = 0;
 bool g_bCurrentBasePlaneIsFifo = false;
 
 static int g_nSteamCompMgrTargetFPS = 0;
+
+// Non-VRR frame-rate limit: a frame is released on the vblank whose nominal time reaches
+// the release grid (the previous release plus the target period), not on every Nth
+// compositor wakeup. The timer steps over the vblanks a late wakeup missed, so counting
+// wakeups turns every late one into a frame held a whole vblank longer: on a fine vblank
+// grid that reads as a cap below the target whenever the compositor thread is scheduled
+// late, and it sinks further as the device throttles.
+//
+// On the gamenative backend the panel's latch grid is known (the daemon measures it from
+// the display's latch stats and the DRM shim answers it), and the vblank grid is not tied
+// to it. When the target period is a whole number of latch periods the release grid is
+// snapped onto the latch grid, offset by a lead the limiter steers itself: it reads where
+// each commit landed in its latch window and aims for the middle, so no two commits fall
+// on one latch point and none sits on the edge. Without the grid the release grid is
+// free-running.
+static uint64_t g_ulFPSLimitNextRelease = 0;
+static bool g_bFPSLimitReleaseThisVBlank = true;
+static uint64_t g_ulFPSLimitLastCommit = 0;
+static uint64_t g_ulFPSLimitLastCommitSeen = 0;
+static int64_t g_lFPSLimitLatchLead = 0;
+static bool g_bFPSLimitOnLatchGrid = false;
+
+extern "C" int gamenative_drm_latch_grid( uint64_t *pulAnchorNs, uint32_t *puPeriodNs, uint32_t *puLeadNs ) __attribute__(( weak ));
+
+// lValue reduced into [-lPeriod/2, lPeriod/2).
+static int64_t steamcompmgr_wrap_ns( int64_t lValue, int64_t lPeriod )
+{
+	const int64_t lHalf = lPeriod / 2;
+	const int64_t r = ( ( lValue + lHalf ) % lPeriod + lPeriod ) % lPeriod;
+	return r - lHalf;
+}
+
+// Snap the release grid onto the latch grid when there is one the target period fits.
+// Returns the period to step the grid by: the latch multiple when snapped.
+static uint64_t steamcompmgr_fps_limit_snap_to_latch_grid( uint64_t ulPeriod )
+{
+	g_bFPSLimitOnLatchGrid = false;
+	if ( !gamenative_drm_latch_grid )
+		return ulPeriod;
+
+	uint64_t ulAnchor = 0;
+	uint32_t uLatch = 0, uLead = 0;
+	if ( !gamenative_drm_latch_grid( &ulAnchor, &uLatch, &uLead ) || !uLatch )
+		return ulPeriod;
+
+	const uint64_t ulMult = ( ulPeriod + uLatch / 2 ) / uLatch;
+	if ( !ulMult )
+		return ulPeriod;
+	const uint64_t ulGrid = ulMult * uLatch;
+	const int64_t lError = int64_t( ulGrid ) - int64_t( ulPeriod );
+	if ( std::abs( lError ) * 100 > int64_t( ulPeriod ) )
+		return ulPeriod;
+
+	// Steer the lead from where the last commit landed in its latch window: aim for the
+	// middle, in steps of an eighth of the error so the pipeline's own jitter is not chased.
+	if ( g_ulFPSLimitLastCommit && g_ulFPSLimitLastCommit != g_ulFPSLimitLastCommitSeen )
+	{
+		g_ulFPSLimitLastCommitSeen = g_ulFPSLimitLastCommit;
+		// Time from the commit to the latch point it lands on: (0, latch].
+		int64_t lMargin = steamcompmgr_wrap_ns( int64_t( ulAnchor ) - int64_t( g_ulFPSLimitLastCommit ), int64_t( uLatch ) );
+		if ( lMargin <= 0 )
+			lMargin += uLatch;
+		const int64_t lErr = lMargin - int64_t( uLatch ) / 2;
+		g_lFPSLimitLatchLead = std::clamp<int64_t>( g_lFPSLimitLatchLead - lErr / 8, 0, int64_t( ulGrid ) - 1 );
+	}
+
+	const int64_t lBase = int64_t( ulAnchor ) - g_lFPSLimitLatchLead;
+	const int64_t lOff = steamcompmgr_wrap_ns( int64_t( g_ulFPSLimitNextRelease ) - lBase, int64_t( ulGrid ) );
+	const int64_t lSnapped = int64_t( g_ulFPSLimitNextRelease ) - lOff;
+	g_ulFPSLimitNextRelease = uint64_t( std::max<int64_t>( lSnapped, 0 ) );
+	g_bFPSLimitOnLatchGrid = true;
+
+	static bool s_bLoggedOnGrid = false;
+	static uint64_t s_ulSteerCount = 0;
+	if ( !s_bLoggedOnGrid || ( ++s_ulSteerCount % 1200 ) == 0 )
+	{
+		s_bLoggedOnGrid = true;
+		xwm_log.infof( "fps limit: on the panel latch grid, period %u us x%u, lead %lld us",
+			uLatch / 1000, (unsigned)ulMult, (long long)( g_lFPSLimitLatchLead / 1000 ) );
+	}
+	return ulGrid;
+}
+
+static void steamcompmgr_update_fps_limit_release( uint64_t ulTargetVBlank )
+{
+	int nRefreshmHz = g_nNestedRefresh ? g_nNestedRefresh : g_nOutputRefresh;
+	int nRefreshHz = gamescope::ConvertmHzToHz( nRefreshmHz );
+	int nTargetFPS = g_nSteamCompMgrTargetFPS;
+
+	if ( !nTargetFPS || nRefreshHz <= nTargetFPS )
+	{
+		g_bFPSLimitReleaseThisVBlank = true;
+		g_ulFPSLimitNextRelease = 0;
+		g_bFPSLimitOnLatchGrid = false;
+		return;
+	}
+
+	uint64_t ulPeriod = gamescope::mHzToRefreshCycle( gamescope::ConvertHztomHz( nTargetFPS ) );
+	const uint64_t ulVBlank = gamescope::mHzToRefreshCycle( nRefreshmHz );
+
+	// First vblank under this cap, or the grid is ahead of us (cap change, clock step): anchor here.
+	if ( g_ulFPSLimitNextRelease == 0 || g_ulFPSLimitNextRelease > ulTargetVBlank + ulPeriod )
+		g_ulFPSLimitNextRelease = ulTargetVBlank;
+
+	ulPeriod = steamcompmgr_fps_limit_snap_to_latch_grid( ulPeriod );
+
+	// Half a vblank of tolerance so a release point that lands a hair past this vblank's
+	// nominal time is not pushed to the next one when the anchor moves.
+	if ( ulTargetVBlank + ulVBlank / 2 < g_ulFPSLimitNextRelease )
+	{
+		g_bFPSLimitReleaseThisVBlank = false;
+		return;
+	}
+
+	g_bFPSLimitReleaseThisVBlank = true;
+	g_ulFPSLimitNextRelease += ulPeriod;
+
+	// A stall longer than a period is a lost frame, not a debt: never release on
+	// consecutive vblanks to catch up.
+	if ( g_ulFPSLimitNextRelease <= ulTargetVBlank + ulVBlank / 2 )
+		g_ulFPSLimitNextRelease = ulTargetVBlank + ulPeriod;
+}
