 bool g_bCurrentBasePlaneIsFifo = false;
 
 static int g_nSteamCompMgrTargetFPS = 0;
+
+// Non-VRR frame-rate limit: a frame is released on the vblank whose nominal time reaches
+// the release grid (the previous release plus the target period), not on every Nth
+// compositor wakeup. The timer steps over the vblanks a late wakeup missed, so counting
+// wakeups turns every late one into a frame held a whole vblank longer: on a fine vblank
+// grid that reads as a cap below the target whenever the compositor thread is scheduled
+// late, and it sinks further as the device throttles.
+static uint64_t g_ulFPSLimitNextRelease = 0;
+static bool g_bFPSLimitReleaseThisVBlank = true;
+
+static void steamcompmgr_update_fps_limit_release( uint64_t ulTargetVBlank )
+{
+	int nRefreshmHz = g_nNestedRefresh ? g_nNestedRefresh : g_nOutputRefresh;
+	int nRefreshHz = gamescope::ConvertmHzToHz( nRefreshmHz );
+	int nTargetFPS = g_nSteamCompMgrTargetFPS;
+
+	if ( !nTargetFPS || nRefreshHz <= nTargetFPS )
+	{
+		g_bFPSLimitReleaseThisVBlank = true;
+		g_ulFPSLimitNextRelease = 0;
+		return;
+	}
+
+	const uint64_t ulPeriod = gamescope::mHzToRefreshCycle( gamescope::ConvertHztomHz( nTargetFPS ) );
+	const uint64_t ulVBlank = gamescope::mHzToRefreshCycle( nRefreshmHz );
+
+	// First vblank under this cap, or the grid is ahead of us (cap change, clock step): anchor here.
+	if ( g_ulFPSLimitNextRelease == 0 || g_ulFPSLimitNextRelease > ulTargetVBlank + ulPeriod )
+		g_ulFPSLimitNextRelease = ulTargetVBlank;
+
+	// Half a vblank of tolerance so a release point that lands a hair past this vblank's
+	// nominal time is not pushed to the next one when the anchor moves.
+	if ( ulTargetVBlank + ulVBlank / 2 < g_ulFPSLimitNextRelease )
+	{
+		g_bFPSLimitReleaseThisVBlank = false;
+		return;
+	}
+
+	g_bFPSLimitReleaseThisVBlank = true;
+	g_ulFPSLimitNextRelease += ulPeriod;
+
+	// A stall longer than a period is a lost frame, not a debt: never release on
+	// consecutive vblanks to catch up.
+	if ( g_ulFPSLimitNextRelease <= ulTargetVBlank + ulVBlank / 2 )
+		g_ulFPSLimitNextRelease = ulTargetVBlank + ulPeriod;
+}
