+// The session reaper ends the session when the game's process is gone -- it
+// watches that process itself, as the primary child it was handed is wine's
+// wrapper chain, which outlives the game. Wine's virtual desktop window
+// outlives the game the same way, so at that point the compositor still has a
+// client to composite and the display is left holding its background. The
+// reaper is a separate process with no way to set anything here, but its exit
+// is the session's end and the compositor already waits on it, so the blank is
+// raised there and the frame is painted once before the loop stops.
+static std::atomic<bool> g_bSessionEndBlank{ false };
+
+// Paints the output black, as one full-output plane from the blank texture the
+// compositor already holds for this purpose.
+static void
+paint_session_end_blank( struct FrameInfo_t *frameInfo )
+{
+	gamescope::Rc<CVulkanTexture> pBlankTexture = vulkan_get_hacky_blank_texture();
+	if ( !pBlankTexture )
+		return;
+
+	FrameInfo_t::Layer_t *layer = frameInfo->layers.push();
+	if ( !layer )
+		return;
+
+	layer->scale.x = g_nOutputWidth == pBlankTexture->width() ? 1.0f : pBlankTexture->width() / (float)g_nOutputWidth;
+	layer->scale.y = g_nOutputHeight == pBlankTexture->height() ? 1.0f : pBlankTexture->height() / (float)g_nOutputHeight;
+	layer->offset.x = 0.0f;
+	layer->offset.y = 0.0f;
+	layer->opacity = 1.0f;
+	layer->zpos = g_zposBase;
+	layer->applyColorMgmt = false;
+	layer->eAlphaBlendingMode = ALPHA_BLENDING_MODE_PREMULTIPLIED;
+	layer->colorspace = GAMESCOPE_APP_TEXTURE_COLORSPACE_SRGB;
+	layer->hdr_metadata_blob = nullptr;
+	layer->ctm = nullptr;
+	layer->tex = pBlankTexture;
+	layer->filter = GamescopeUpscaleFilter::NEAREST;
+	layer->blackBorder = true;
+}
+
+// gamenative: one-shot stated outcome for the session blind, so the panel
+// evidence at each transition can be tied to the predicate instead of a guess.
+static LogScope s_SessionBlankLogScope( "session-blank" );
+
+// The game's window is gone while the session is still alive whenever the only
+// window the compositor has left -- wine's virtual desktop -- is carrying
+// nothing but its own 2D content. That is what is on the panel as the solid
+// desktop blue, and it appears at BOTH transitions: at startup, until the
+// guest's first frame arrives on the override surface, and at exit, once the
+// game's window and with it the override are gone.
+//
+// The discriminator is therefore the texture selection itself, not the app-id:
+// A26 gives every window the same uniform app-id, so the app-id cannot tell the
+// game's window from the desktop's. What can is where the compositor's newest
+// done commit for the window came from -- the WSI shim binds an override
+// surface on the wine desktop window for the guest's swapchain, and
+// get_window_last_done_commit() is surface-agnostic (last-done-wins), so the
+// commit's own surface says which of the two content streams is being painted.
+//
+// Two properties are load-bearing and are why this is safe:
+//   - it cannot be true during normal play: while the game runs the override
+//     commits every frame, so the newest done commit is always the override;
+//   - it cannot wedge a session that never opens a second window: the latch is
+//     only ever set by the override surface coming into existence, so a session
+//     whose guest never brings one up is never blanked.
+static bool
+session_game_window_absent( steamcompmgr_win_t *w )
+{
+	if ( w == nullptr || w->type != steamcompmgr_win_type_t::XWAYLAND )
+		return false;
+
+	struct wlr_surface *override_surface = w->xwayland().surface.override_surface;
+	if ( override_surface != nullptr )
+		w->bSessionSawGameWindow = true;
+
+	if ( !w->bSessionSawGameWindow )
+		return false;
+
+	gamescope::Rc<commit_t> lastCommit;
+	get_window_last_done_commit( w, lastCommit );
+
+	// The guest's own content is what would be painted only while the newest
+	// done commit is the override's. Null override, no commit, or a commit from
+	// the window's own surface all mean the desktop is all that is left.
+	return lastCommit == nullptr || lastCommit->surf != override_surface;
+}
