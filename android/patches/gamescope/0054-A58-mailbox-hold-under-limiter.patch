+// gamenative A58: mailbox hold under the FPS limiter.
+//
+// A mailbox client pacing itself just under the refresh rate (59.3 fps under a
+// 60 cap on a 59.97 Hz panel) completes two commits inside one composite window
+// about once a second. Collapsing them to the newest, as mailbox does, makes
+// the panel repeat a frame. Only gamescope knows where its latch point is, so
+// the hold lives here: once a window has had a non-FIFO commit latched for the
+// coming paint, a newer one is held and latched for the paint after it. The
+// hold is one deep: a third commit replaces the held one, which is released
+// (and its presentation feedback discarded) right away, as mailbox would. The
+// client is never blocked, and a window at or below the refresh rate never
+// loses a frame. A held commit is latched by the first done-commit pass of the
+// next vblank cycle; the vblank pass always runs one, so an idle client does
+// not leave it stuck.
+//
+// A held commit is shown one paint after the one it completed for. If the
+// client keeps delivering one commit per vblank, that one-paint delay never
+// drains: every new commit finds its paint taken by the carried one and is
+// carried in turn. So the carry is bounded: once gn_mailbox_hold_max_carry
+// paints in a row have shown a carried commit, the next fresh commit is
+// latched at once and replaces the carried one (a mailbox replace: one frame
+// dropped, the window back on its own paint). A client below the refresh rate
+// drains the carry by itself at its next gap.
+//
+// gn_mailbox_hold: -1 = auto (on when the gamenative-drm backend is in use),
+// 0 = off, 1 = on. Overridable with gamescope_gn_mailbox_hold=0/1 and, on
+// Android, the property debug.gamescope.gn_mailbox_hold=0/1 (wins when set).
+// gn_mailbox_hold_max_carry: paints in a row a carried commit may hold the
+// window before a fresh one displaces it (0 = unbounded); same env/property
+// pattern (debug.gamescope.gn_mailbox_hold_max_carry). Both are resolved
+// once, at the first done-commit pass.
+gamescope::ConVar<int> cv_gn_mailbox_hold{ "gn_mailbox_hold", -1, "gamenative: hold one newer mailbox commit for the next vblank while the FPS limiter is engaged (-1 auto, 0 off, 1 on)." };
+gamescope::ConVar<int> cv_gn_mailbox_hold_max_carry{ "gn_mailbox_hold_max_carry", 8, "gamenative: paints in a row a held mailbox commit may be shown late before a fresh commit displaces it (0 = unbounded)." };
+
+#if defined(__ANDROID__)
+// An integer Android property, or nullopt when it is unset or not a number.
+static std::optional<int> gn_int_property( const char *pszName )
+{
+	char szProp[ PROP_VALUE_MAX ] = {};
+	if ( __system_property_get( pszName, szProp ) <= 0 )
+		return std::nullopt;
+	char *pEnd = nullptr;
+	long lValue = strtol( szProp, &pEnd, 10 );
+	if ( pEnd == szProp || *pEnd != '\0' )
+		return std::nullopt;
+	return (int)lValue;
+}
+#endif
+
+static int s_nGnMailboxMaxCarry = 0;
+
+static bool gn_mailbox_hold_enabled()
+{
+	static const bool s_bEnabled = []()
+	{
+		const char *pszSource = "default";
+		bool bEnabled;
+		{
+			const char *pszSock = getenv( "GAMENATIVE_DRM_SOCKET" );
+			bEnabled = pszSock && *pszSock;
+		}
+		if ( cv_gn_mailbox_hold != -1 )
+		{
+			bEnabled = cv_gn_mailbox_hold != 0;
+			pszSource = "env";
+		}
+		s_nGnMailboxMaxCarry = std::max( 0, (int)cv_gn_mailbox_hold_max_carry );
+#if defined(__ANDROID__)
+		if ( std::optional<int> oProp = gn_int_property( "debug.gamescope.gn_mailbox_hold" ); oProp && ( *oProp == 0 || *oProp == 1 ) )
+		{
+			bEnabled = *oProp == 1;
+			pszSource = "prop";
+		}
+		if ( std::optional<int> oProp = gn_int_property( "debug.gamescope.gn_mailbox_hold_max_carry" ); oProp && *oProp >= 0 )
+			s_nGnMailboxMaxCarry = *oProp;
+#endif
+		xwm_log.infof( "gn_mailbox_hold=%d source=%s max_carry=%d", bEnabled ? 1 : 0, pszSource, s_nGnMailboxMaxCarry );
+		return bEnabled;
+	}();
+	return s_bEnabled;
+}
+
+static bool gn_mailbox_hold_applies( steamcompmgr_win_t *w )
+{
+	if ( !w || !gn_mailbox_hold_enabled() )
+		return false;
+	if ( !g_nSteamCompMgrTargetFPS || !steamcompmgr_window_should_limit_fps( w ) )
+		return false;
+	if ( GetBackend()->GetCurrentConnector() && GetBackend()->GetCurrentConnector()->IsVRRActive() )
+		return false;
+	return true;
+}
+
+// Counters for the report line, since start.
+static uint64_t s_ulGnDeferred = 0;      // commits held for a later paint (each counted once)
+static uint64_t s_ulGnReplaced = 0;      // held commits replaced by a newer one before their paint
+static uint64_t s_ulGnCarriedPaints = 0; // paints that showed a carried commit (one paint late)
+static uint64_t s_ulGnCollapsed = 0;     // carries ended by a fresh commit (gn_mailbox_hold_max_carry)
+static uint32_t s_uGnMaxRun = 0;         // longest run of carried paints since the last report
+
+// vblank_idx is the cycle whose paint a done-commit pass feeds (it advances
+// after the vblank pass's done-commit handling); +1 keeps 0 as "none". A held
+// commit can therefore never be latched for the paint it was held from: the
+// paint id only changes when vblank_idx does.
+static inline uint64_t gn_mailbox_paint_id( uint64_t vblank_idx ) { return vblank_idx + 1; }
+
+// Decide for a done commit. Returns true when the entry is held: it was put
+// (or replaced the window's held entry) in `held`, the list carried to the
+// next pass, marked gnHeld. `held_index` maps a window seq to its held entry
+// in `held` for this pass. Returns false when the entry is latched now.
+static bool gn_mailbox_hold_entry( steamcompmgr_win_t *w, const CommitDoneEntry_t &entry, uint64_t vblank_idx,
+	std::vector< CommitDoneEntry_t > &held, std::unordered_map< uint64_t, size_t > &held_index )
+{
+	if ( entry.fifo || !gn_mailbox_hold_applies( w ) )
+		return false;
+
+	// Nothing latched for the coming paint yet: latch this one.
+	if ( w->gnMailboxLatchedForPaint != gn_mailbox_paint_id( vblank_idx ) )
+		return false;
+
+	// The paint is taken by a carried commit and the carry has run its bound:
+	// a fresh commit is latched now and replaces it (gn_mailbox_hold_latched).
+	if ( !entry.gnHeld && w->gnMailboxLatchedCarried && s_nGnMailboxMaxCarry > 0 &&
+	     w->gnMailboxCarryRun >= (uint32_t)s_nGnMailboxMaxCarry )
+	{
+		s_ulGnCollapsed++;
+		return false;
+	}
+
+	CommitDoneEntry_t heldEntry = entry;
+	heldEntry.gnHeld = true;
+	if ( !entry.gnHeld )
+		s_ulGnDeferred++;
+
+	auto iter = held_index.find( entry.winSeq );
+	if ( iter == held_index.end() )
+	{
+		held_index[ entry.winSeq ] = held.size();
+		held.push_back( heldEntry );
+		return true;
+	}
+
+	// A third commit in the window: it replaces the held one. Dropping the
+	// replaced commit from the queue releases its buffer and discards its
+	// presentation feedback (commit_t's destructor), as a mailbox replace does.
+	CommitDoneEntry_t &replaced = held[ iter->second ];
+	for ( auto it = w->commit_queue.begin(); it != w->commit_queue.end(); ++it )
+	{
+		if ( (*it)->commitID == replaced.commitID )
+		{
+			w->commit_queue.erase( it );
+			break;
+		}
+	}
+	replaced = heldEntry;
+	s_ulGnReplaced++;
+	return true;
+}
+
+// A non-FIFO commit was latched for the coming paint: record it, and whether
+// it is a carried one (held from the paint before).
+static void gn_mailbox_hold_latched( steamcompmgr_win_t *w, const CommitDoneEntry_t &entry, uint64_t vblank_idx )
+{
+	const uint64_t ulPaint = gn_mailbox_paint_id( vblank_idx );
+	if ( w->gnMailboxLatchedForPaint == ulPaint )
+	{
+		// A second latch for the same paint: a fresh commit displacing a
+		// carried one, or a window the hold does not apply to.
+		if ( w->gnMailboxLatchedCarried && !entry.gnHeld && s_ulGnCarriedPaints )
+			s_ulGnCarriedPaints--;
+	}
+	else if ( entry.gnHeld )
+	{
+		w->gnMailboxCarryRun++;
+		s_ulGnCarriedPaints++;
+		s_uGnMaxRun = std::max( s_uGnMaxRun, w->gnMailboxCarryRun );
+	}
+	if ( !entry.gnHeld )
+		w->gnMailboxCarryRun = 0;
+	w->gnMailboxLatchedForPaint = ulPaint;
+	w->gnMailboxLatchedCarried = entry.gnHeld;
+}
+
+// One line per ~600 cycles while the hold does anything, to confirm it is
+// active and show what it costs: deferred = commits held for a later paint,
+// carried_paints = paints that showed a commit one paint late, max_run = the
+// longest run of those in a row, collapsed = carries ended by the bound,
+// replaced = held commits dropped for a newer one.
+static void gn_mailbox_hold_report( uint64_t vblank_idx )
+{
+	static uint64_t s_ulLastReportIdx = 0;
+	static uint64_t s_ulLast[ 4 ] = {};
+	if ( vblank_idx < s_ulLastReportIdx + 600 )
+		return;
+	const uint64_t ulNow[ 4 ] = { s_ulGnDeferred, s_ulGnCarriedPaints, s_ulGnCollapsed, s_ulGnReplaced };
+	if ( memcmp( ulNow, s_ulLast, sizeof( ulNow ) ) != 0 )
+	{
+		xwm_log.infof( "gn_mailbox_hold: deferred=%" PRIu64 " carried_paints=%" PRIu64 " max_run=%u collapsed=%" PRIu64 " replaced=%" PRIu64 " over %" PRIu64 " vblanks",
+			ulNow[ 0 ] - s_ulLast[ 0 ], ulNow[ 1 ] - s_ulLast[ 1 ], s_uGnMaxRun,
+			ulNow[ 2 ] - s_ulLast[ 2 ], ulNow[ 3 ] - s_ulLast[ 3 ], vblank_idx - s_ulLastReportIdx );
+	}
+	s_ulLastReportIdx = vblank_idx;
+	memcpy( s_ulLast, ulNow, sizeof( ulNow ) );
+	s_uGnMaxRun = 0;
+}
