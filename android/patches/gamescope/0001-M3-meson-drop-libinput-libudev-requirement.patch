android: M3 — build without libinput/libudev

On Android there is no evdev access (/dev/input/event* needs root) and no
logind/seatd session, so gamescope's libinput paths can never deliver input.
Input is app-injected instead via virtual-input protocols (patch I1).

- dependency('libinput'/'libudev') -> required: false
- LibInputHandler.cpp compiled only when libinput is found (its sole user,
  OpenVRBackend, is already conditional and disabled in our build)
- required_wlroots_features 'libinput_backend' only when libinput found
- new -DHAVE_LIBINPUT define; guards in wlserver.cpp for the wlroots
  libinput backend creation, its include, and the touch->connector heuristic

---
diff --git a/src/meson.build b/src/meson.build
index 79a9550..e7ee9c4 100644
--- a/src/meson.build
+++ b/src/meson.build
@@ -21,7 +21,9 @@ epoll_dep = dependency('epoll-shim', required: false)
 sdl2_dep = dependency('SDL2', required: get_option('sdl2_backend'))
 avif_dep = dependency('libavif', version: '>=1.0.0', required: get_option('avif_screenshots'))
 pixman_dep = dependency('pixman-1')
-udev_dep = dependency('libudev')
+# gamenative M3: libudev is only consumed by the libinput paths below
+# (LibInputHandler/OpenVR + touch heuristic); optional so Android can drop both.
+udev_dep = dependency('libudev', required: false)
 
 wlroots_dep = dependency(
   'wlroots-0.20',
@@ -122,17 +124,25 @@ src = [
   'backend.cpp',
   'x11cursor.cpp',
   'InputEmulation.cpp',
-  'LibInputHandler.cpp',
 ]
 
 luajit_dep = dependency( 'luajit' )
-libinput_dep = dependency('libinput', required: true)
+# gamenative M3: libinput is only needed for session-based KMS input acquisition
+# (wlroots libinput backend, touch->connector heuristic) and by LibInputHandler,
+# which is used solely by the OpenVR backend. Platforms without evdev access
+# (Android) build without it and inject input via virtual-input protocols.
+libinput_dep = dependency('libinput', required: false)
+if libinput_dep.found()
+  src += 'LibInputHandler.cpp'
+endif
 
 gamescope_cpp_args = []
 if drm_dep.found()
   src += 'Backends/DRMBackend.cpp'
   src += 'modegen.cpp'
-  required_wlroots_features += 'libinput_backend'
+  if libinput_dep.found()
+    required_wlroots_features += 'libinput_backend'
+  endif
   liftoff_dep = dependency(
     'libliftoff',
     version: ['>= 0.5.0', '< 0.6.0'],
diff --git a/src/wlserver.cpp b/src/wlserver.cpp
