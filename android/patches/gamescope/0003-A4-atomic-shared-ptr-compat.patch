diff --git a/src/Utils/AtomicSharedPtr.h b/src/Utils/AtomicSharedPtr.h
new file mode 100644
index 0000000..c987bff
--- /dev/null
+++ b/src/Utils/AtomicSharedPtr.h
@@ -0,0 +1,61 @@
+#pragma once
+
+// gamenative A4: NDK libc++ has no std::atomic<std::shared_ptr<T>> specialization
+// (the primary template requires trivially-copyable T), and the C++11
+// std::atomic_load/std::atomic_store shared_ptr free functions are deprecated in
+// C++20 (would add warnings). Drop-in replacement with the same member API,
+// implemented over a mutex — contention is irrelevant for its uses here
+// (cursor/title/icon hints, color LUTs, focus window name).
+
+#include <memory>
+#include <mutex>
+
+namespace gamescope
+{
+    template <typename T>
+    struct atomic_shared_ptr
+    {
+        mutable std::mutex m_Mutex;
+        std::shared_ptr<T> m_pPtr;
+
+        atomic_shared_ptr() noexcept = default;
+        atomic_shared_ptr( std::nullptr_t ) noexcept {}
+        atomic_shared_ptr( std::shared_ptr<T> pPtr ) noexcept : m_pPtr( std::move( pPtr ) ) {}
+
+        atomic_shared_ptr( const atomic_shared_ptr & ) = delete;
+        atomic_shared_ptr &operator=( const atomic_shared_ptr & ) = delete;
+
+        std::shared_ptr<T> load() const noexcept
+        {
+            std::lock_guard lock( m_Mutex );
+            return m_pPtr;
+        }
+
+        void store( std::shared_ptr<T> pPtr ) noexcept
+        {
+            std::lock_guard lock( m_Mutex );
+            m_pPtr = std::move( pPtr );
+        }
+
+        std::shared_ptr<T> exchange( std::shared_ptr<T> pPtr ) noexcept
+        {
+            std::lock_guard lock( m_Mutex );
+            std::swap( m_pPtr, pPtr );
+            return pPtr;
+        }
+
+        operator std::shared_ptr<T>() const noexcept { return load(); }
+
+        atomic_shared_ptr &operator=( std::shared_ptr<T> pPtr ) noexcept
+        {
+            store( std::move( pPtr ) );
+            return *this;
+        }
+
+        atomic_shared_ptr &operator=( std::nullptr_t ) noexcept
+        {
+            store( nullptr );
+            return *this;
+        }
+    };
+}
