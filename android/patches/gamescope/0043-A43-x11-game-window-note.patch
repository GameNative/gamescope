+
+// gamenative A43/A44: the booting splash is cleared by the daemon when it hears
+// the game's window is up. The ICD shim reports that from its swapchain present,
+// which a game drawn through X (OpenGL, GDI) or a static dialog never reaches.
+// So the compositor follows the X11 server's rule and sends the same note
+// itself on the first top-level map.
+static constexpr uint64_t k_ulX11GameWindowResendNs = 1'000'000'000ull;
+static constexpr uint32_t k_unX11GameWindowMaxNotes = 3;
+
+static struct
+{
+	Window firstMapped = None;
+	uint64_t ulLastAttempt = 0;
+	uint32_t unNotes = 0;
+} s_X11GameWindow;
+
+// One GameWindowNote (gndrm-uapi wire.rs: "GNW1", present = 1, 16 reserved
+// bytes) on a fresh scan-out connection. The daemon serves the newest
+// connection, reads the note and drops the channel when it closes.
+static bool
+send_game_window_note()
+{
+	const char *pszSock = getenv( "GAMENATIVE_DRM_SOCKET" );
+	if ( !pszSock || !*pszSock )
+		return false;
+
+	struct sockaddr_un sa = {};
+	sa.sun_family = AF_UNIX;
+	if ( pszSock[ 0 ] == '@' )
+		strncpy( sa.sun_path + 1, pszSock + 1, sizeof( sa.sun_path ) - 2 );
+	else if ( strchr( pszSock, '/' ) )
+		strncpy( sa.sun_path, pszSock, sizeof( sa.sun_path ) - 1 );
+	else
+		strncpy( sa.sun_path + 1, pszSock, sizeof( sa.sun_path ) - 2 );
+
+	int fd = socket( AF_UNIX, SOCK_SEQPACKET | SOCK_CLOEXEC, 0 );
+	if ( fd < 0 )
+		return false;
+
+	struct timeval tv = { 0, 250'000 };
+	setsockopt( fd, SOL_SOCKET, SO_SNDTIMEO, &tv, sizeof( tv ) );
+
+	bool bSent = false;
+	if ( connect( fd, (struct sockaddr *)&sa, sizeof( sa ) ) == 0 )
+	{
+		uint8_t note[ 24 ] = {};
+		const uint32_t uMagic = 0x474E5731;
+		const uint32_t uPresent = 1;
+		memcpy( note, &uMagic, sizeof( uMagic ) );
+		memcpy( note + 4, &uPresent, sizeof( uPresent ) );
+		bSent = send( fd, note, sizeof( note ), MSG_NOSIGNAL ) == (ssize_t)sizeof( note );
+	}
+	close( fd );
+	return bSent;
 }
 
+// The daemon serves only the newest scan-out connection, so a note can be
+// dropped when another client connects right after it. Notes are sent at most
+// once a second and at most three in all; the daemon latches the first.
+static void
+x11_game_window_note( const char *pszReason )
+{
+	auto &s = s_X11GameWindow;
+	if ( s.unNotes >= k_unX11GameWindowMaxNotes )
+		return;
+
+	uint64_t ulNow = get_time_in_nanos();
+	if ( s.ulLastAttempt != 0 && ulNow - s.ulLastAttempt < k_ulX11GameWindowResendNs )
+		return;
+	s.ulLastAttempt = ulNow;
+
+	bool bSent = send_game_window_note();
+	if ( bSent )
+	{
+		s.unNotes++;
+		hasRepaint = true;
+	}
+	xwm_log.infof( "%s 0x%lx: game window note %s (%u/%u)",
+		pszReason, s.firstMapped, bSent ? "sent" : "failed", s.unNotes, k_unX11GameWindowMaxNotes );
+}
+
+static void
+x11_top_level_mapped( steamcompmgr_win_t *w )
+{
+	auto &s = s_X11GameWindow;
+	if ( s.firstMapped != None )
+		return;
+
+	s.firstMapped = w->xwayland().id;
+	x11_game_window_note( "first top-level map" );
+}
