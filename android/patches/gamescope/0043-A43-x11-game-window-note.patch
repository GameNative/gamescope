+// gamenative A43: the booting splash is cleared by the daemon when it hears the
+// game's window is up. The ICD shim reports that from its swapchain present, so a
+// game that never presents through the shim (OpenGL drawn through X, GDI) never
+// clears it. While no override surface is bound, a wine desktop window that
+// keeps committing its own surface with a game child mapped is that game
+// drawing through X, and the compositor sends the same note itself.
+static LogScope s_GameWindowLogScope( "game-window" );
+
+static constexpr uint64_t k_ulX11GameWindowSampleNs = 1'000'000'000ull;
+static constexpr uint32_t k_unX11GameWindowMinCommits = 20;
+static constexpr uint32_t k_unX11GameWindowMaxNotes = 3;
+
+static struct
+{
+	uint64_t ulSampleStart = 0;
+	uint32_t unCommits = 0;
+	uint32_t unNotes = 0;
+} s_X11GameWindow;
+
+static std::string
+x11_window_instance( Display *dpy, Window win )
+{
+	std::string instance;
+	XClassHint hint = {};
+	if ( !XGetClassHint( dpy, win, &hint ) )
+		return instance;
+	if ( hint.res_name )
+	{
+		instance = hint.res_name;
+		XFree( hint.res_name );
+	}
+	if ( hint.res_class )
+		XFree( hint.res_class );
+	return instance;
+}
+
+// Same rule as the shim's child scan: a viewable, InputOutput, non-degenerate
+// child of the desktop window whose WM_CLASS instance is readable and differs
+// from the desktop's own.
+static bool
+x11_game_child_present( Display *dpy, Window desktop )
+{
+	std::string desktopInstance = x11_window_instance( dpy, desktop );
+	if ( desktopInstance.empty() )
+		return false;
+
+	Window root = None, parent = None;
+	Window *children = nullptr;
+	unsigned int nchildren = 0;
+	if ( !XQueryTree( dpy, desktop, &root, &parent, &children, &nchildren ) )
+		return false;
+
+	bool bFound = false;
+	for ( unsigned int i = 0; i < nchildren && !bFound; i++ )
+	{
+		XWindowAttributes attribs;
+		if ( !XGetWindowAttributes( dpy, children[ i ], &attribs ) )
+			continue;
+		if ( attribs.map_state != IsViewable || attribs.c_class != InputOutput )
+			continue;
+		if ( attribs.width <= 1 || attribs.height <= 1 )
+			continue;
+		std::string childInstance = x11_window_instance( dpy, children[ i ] );
+		bFound = !childInstance.empty() && childInstance != desktopInstance;
+	}
+
+	if ( children )
+		XFree( children );
+	return bFound;
+}
+
+// One GameWindowNote (gndrm-uapi wire.rs: "GNW1", present = 1, 16 reserved
+// bytes) on a fresh scan-out connection. The daemon serves the newest
+// connection, reads the note and drops the channel when it closes.
+static bool
+send_game_window_note()
+{
+	const char *pszSock = getenv( "GAMENATIVE_DRM_SOCKET" );
+	if ( !pszSock || !*pszSock )
+		return false;
+
+	struct sockaddr_un sa = {};
+	sa.sun_family = AF_UNIX;
+	if ( pszSock[ 0 ] == '@' )
+		strncpy( sa.sun_path + 1, pszSock + 1, sizeof( sa.sun_path ) - 2 );
+	else if ( strchr( pszSock, '/' ) )
+		strncpy( sa.sun_path, pszSock, sizeof( sa.sun_path ) - 1 );
+	else
+		strncpy( sa.sun_path + 1, pszSock, sizeof( sa.sun_path ) - 2 );
+
+	int fd = socket( AF_UNIX, SOCK_SEQPACKET | SOCK_CLOEXEC, 0 );
+	if ( fd < 0 )
+		return false;
+
+	struct timeval tv = { 0, 250'000 };
+	setsockopt( fd, SOL_SOCKET, SO_SNDTIMEO, &tv, sizeof( tv ) );
+
+	bool bSent = false;
+	if ( connect( fd, (struct sockaddr *)&sa, sizeof( sa ) ) == 0 )
+	{
+		uint8_t note[ 24 ] = {};
+		const uint32_t uMagic = 0x474E5731;
+		const uint32_t uPresent = 1;
+		memcpy( note, &uMagic, sizeof( uMagic ) );
+		memcpy( note + 4, &uPresent, sizeof( uPresent ) );
+		bSent = send( fd, note, sizeof( note ), MSG_NOSIGNAL ) == (ssize_t)sizeof( note );
+	}
+	close( fd );
+	return bSent;
+}
+
+static void
+x11_game_window_commit( xwayland_ctx_t *ctx, steamcompmgr_win_t *w, struct wlr_surface *surf )
+{
+	auto &s = s_X11GameWindow;
+	if ( s.unNotes >= k_unX11GameWindowMaxNotes )
+		return;
+	if ( w == nullptr || w->type != steamcompmgr_win_type_t::XWAYLAND )
+		return;
+
+	global_focus_t *pFocus = GetCurrentFocus();
+	if ( !pFocus || pFocus->focusWindow != w )
+		return;
+
+	if ( w->xwayland().surface.override_surface != nullptr || w->bSessionSawGameWindow )
+	{
+		s.ulSampleStart = 0;
+		s.unCommits = 0;
+		return;
+	}
+
+	if ( surf != w->xwayland().surface.main_surface )
+		return;
+
+	uint64_t ulNow = get_time_in_nanos();
+	if ( s.ulSampleStart == 0 )
+		s.ulSampleStart = ulNow;
+	s.unCommits++;
+	if ( ulNow - s.ulSampleStart < k_ulX11GameWindowSampleNs )
+		return;
+
+	bool bRendering = s.unCommits >= k_unX11GameWindowMinCommits;
+	uint32_t unCommits = s.unCommits;
+	s.ulSampleStart = ulNow;
+	s.unCommits = 0;
+	if ( !bRendering || !x11_game_child_present( ctx->dpy, w->xwayland().id ) )
+		return;
+
+	bool bSent = send_game_window_note();
+	if ( bSent )
+		s.unNotes++;
+	s_GameWindowLogScope.infof( "X11 game window drawing on 0x%lx (%u commits/s): note %s (%u/%u)",
+		w->xwayland().id, unCommits, bSent ? "sent" : "failed", s.unNotes, k_unX11GameWindowMaxNotes );
+}
+
