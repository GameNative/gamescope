diff --git a/src/vblankmanager.cpp b/src/vblankmanager.cpp
index 3eb99ac..c70b05d 100644
--- a/src/vblankmanager.cpp
+++ b/src/vblankmanager.cpp
@@ -279,6 +279,22 @@ namespace gamescope
 		}
 	}
 
+	void CVBlankTimer::RequestRefreshmHz( int nRefreshmHz )
+	{
+		m_nPendingRefreshmHz = nRefreshmHz;
+	}
+
+	bool CVBlankTimer::ApplyPendingRefresh()
+	{
+		int nRefreshmHz = m_nPendingRefreshmHz.exchange( 0 );
+		if ( nRefreshmHz <= 0 || nRefreshmHz == g_nNestedRefresh )
+			return false;
+
+		g_VBlankLog.infof( "gn_panel_refresh applied: vblank grid %d mHz (was %d mHz)", nRefreshmHz, g_nNestedRefresh );
+		g_nNestedRefresh = nRefreshmHz;
+		return true;
+	}
+
 	bool CVBlankTimer::UsingTimerFD() const
 	{
 		return m_nNudgePipe[ 0 ] < 0;
