+static uint32_t pick_primary_format( const struct wlr_drm_format_set *formats, VkFormatFeatureFlags neededFeatures, VkFormatFeatureFlags neededShadowFeatures = 0 )
+{
+	// Pick a 10-bit format at first for our composition buffer, for a couple of reasons:
+	//
+	// 1. Many game engines automatically render to 10-bit formats such as UE4 which means
+	// that when we have to composite, we can keep the same HW dithering that we would get if
+	// we just scanned them out directly.
+	//
+	// 2. When compositing HDR content as a fallback when we undock, it avoids introducing
+	// a bunch of horrible banding when going to G2.2 curve.
+	// It ensures that we can dither that.
+	uint32_t uFormat = pick_plane_format( formats, DRM_FORMAT_XRGB2101010, DRM_FORMAT_ARGB2101010, neededFeatures, neededShadowFeatures );
+	if ( uFormat == DRM_FORMAT_INVALID )
+		uFormat = pick_plane_format( formats, DRM_FORMAT_XBGR2101010, DRM_FORMAT_ABGR2101010, neededFeatures, neededShadowFeatures );
+	if ( uFormat == DRM_FORMAT_INVALID )
+		uFormat = pick_plane_format( formats, DRM_FORMAT_XRGB8888, DRM_FORMAT_ARGB8888, neededFeatures, neededShadowFeatures );
+	if ( uFormat == DRM_FORMAT_INVALID )
+		uFormat = pick_plane_format( formats, DRM_FORMAT_XBGR8888, DRM_FORMAT_ABGR8888, neededFeatures, neededShadowFeatures );
+	return uFormat;
