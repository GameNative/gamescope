+bool vulkan_format_supports_optimal_features(VkFormat format, VkFormatFeatureFlags features)
+{
+	VkFormatProperties formatProps = {};
+	g_device.vk.GetPhysicalDeviceFormatProperties( g_device.physDev(), format, &formatProps );
+	return ( formatProps.optimalTilingFeatures & features ) == features;
+}
+
+void vulkan_log_format_modifiers(uint32_t drmFormat)
+{
+	const char szFourcc[5] = { char( drmFormat & 0xff ), char( ( drmFormat >> 8 ) & 0xff ), char( ( drmFormat >> 16 ) & 0xff ), char( ( drmFormat >> 24 ) & 0xff ), 0 };
+	VkFormat format = DRMFormatToVulkan( drmFormat, false );
+	if ( format == VK_FORMAT_UNDEFINED )
+	{
+		vk_log.infof( "plane format %s: no Vulkan format", szFourcc );
+		return;
+	}
+
+	VkDrmFormatModifierPropertiesListEXT modifierPropList = {
+		.sType = VK_STRUCTURE_TYPE_DRM_FORMAT_MODIFIER_PROPERTIES_LIST_EXT,
+	};
+	VkFormatProperties2 formatProps = {
+		.sType = VK_STRUCTURE_TYPE_FORMAT_PROPERTIES_2,
+		.pNext = g_device.supportsModifiers() ? &modifierPropList : nullptr,
+	};
+	g_device.vk.GetPhysicalDeviceFormatProperties2( g_device.physDev(), format, &formatProps );
+
+	std::vector<VkDrmFormatModifierPropertiesEXT> modifierProps( modifierPropList.drmFormatModifierCount );
+	if ( modifierPropList.drmFormatModifierCount )
+	{
+		modifierPropList.pDrmFormatModifierProperties = modifierProps.data();
+		g_device.vk.GetPhysicalDeviceFormatProperties2( g_device.physDev(), format, &formatProps );
+	}
+
+	char szMods[ 1024 ] = {};
+	size_t uOff = 0;
+	for ( const auto &mod : modifierProps )
+	{
+		if ( uOff >= sizeof( szMods ) - 1 )
+			break;
+		uOff += snprintf( szMods + uOff, sizeof( szMods ) - uOff, " 0x%" PRIx64 ":features=0x%x,planes=%u",
+			mod.drmFormatModifier, mod.drmFormatModifierTilingFeatures, mod.drmFormatModifierPlaneCount );
+	}
+	vk_log.infof( "plane format %s (vk %u): optimal=0x%x linear=0x%x modifiers=%u%s",
+		szFourcc, uint32_t( format ), formatProps.formatProperties.optimalTilingFeatures,
+		formatProps.formatProperties.linearTilingFeatures, modifierPropList.drmFormatModifierCount, szMods );
+}
