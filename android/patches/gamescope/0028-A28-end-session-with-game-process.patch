+    // The session is over when no guest image is left. Wine's own processes --
+    // the wrapper chain that started the game, explorer, services -- outlive the
+    // game, so waiting on the primary child alone would keep the session alive
+    // after it quits; the guest watch ignores them by living in drive_c/windows.
+    //
+    // An empty guest set alone is not an exit: a launcher hands off to a game
+    // image that may be differently named and may take a while to appear, and
+    // ending the session in that gap kills the game as it starts. The session's
+    // tree fingerprint separates the two cases -- a handoff keeps the tree
+    // moving, a finished session goes still.
+    //
+    // The watch is driven by events, not a poll. While a guest runs the reaper
+    // sleeps until something happens: a child exit (SIGCHLD -- as subreaper it
+    // inherits wine's double-forked processes, the game among them), a nudge
+    // from the compositor (SIGUSR1, sent when a guest's window maps or goes
+    // away), or a slow heartbeat for an exit that produced neither. Only after
+    // the guest set has emptied does it sample the tree at a short interval,
+    // and only for the two seconds it takes to call the tree still.
+    static void WaitForSessionEnd( pid_t nPrimaryChild )
+    {
+        using namespace std::chrono;
+        const milliseconds kStillToEnd{ 2000 };   // a still, guest-less tree this long is the end
+        const milliseconds kCountdownStep{ 250 }; // tree samples while deciding
+        const milliseconds kStartupStep{ 500 };   // until the first guest is seen
+        const milliseconds kHeartbeat{ 10000 };   // while a guest runs
+
+        sigset_t waitSet;
+        sigemptyset( &waitSet );
+        sigaddset( &waitSet, SIGCHLD );
+        sigaddset( &waitSet, SIGUSR1 );
+        sigprocmask( SIG_BLOCK, &waitSet, nullptr );
+
+        bool bSeen = false;
+        uint64_t nTreeStamp = 0;
+        std::optional<steady_clock::time_point> oStillSince;
+
+        while ( s_bRun )
+        {
+            // Reap whatever has exited. The primary child's exit ends the
+            // session outright; anything else reparented to us is just taken
+            // off the table so it does not linger as a zombie in the tree.
+            for ( ;; )
+            {
+                int nStatus = 0;
+                pid_t nDeadChild = waitpid( -1, &nStatus, WNOHANG );
+                if ( nDeadChild == nPrimaryChild || ( nDeadChild == -1 && errno == ECHILD ) )
+                    return;
+                if ( nDeadChild <= 0 )
+                    break;
+            }
+
+            milliseconds wait = kStartupStep;
+            if ( Process::IsGuestProcessRunning() )
+            {
+                bSeen = true;
+                oStillSince.reset();
+                wait = kHeartbeat;
+            }
+            else if ( bSeen )
+            {
+                // A handoff keeps the session's process tree moving -- a fork
+                // here, an exit there -- while a finished session goes still, so
+                // only a still tree runs the clock. An unreadable /proc (zero)
+                // keeps the flat window.
+                const uint64_t nStamp = Process::SessionTreeStamp( nPrimaryChild );
+                const bool bTreeMoved = nStamp != 0 && nStamp != nTreeStamp;
+                nTreeStamp = nStamp;
+
+                const steady_clock::time_point now = steady_clock::now();
+                if ( bTreeMoved || !oStillSince )
+                    oStillSince = now;
+                else if ( now - *oStillSince >= kStillToEnd )
+                {
+                    s_ReaperLog.infof( "No guest process left. Ending session." );
+                    return;
+                }
+                wait = kCountdownStep;
+            }
+
+            // Sleep until a child exits, the compositor nudges us, or the wait
+            // runs out. A termination signal interrupts the wait (EINTR) and
+            // its handler has cleared s_bRun.
+            struct timespec ts{ (time_t) ( wait.count() / 1000 ), (long) ( wait.count() % 1000 ) * 1000 * 1000 };
+            sigtimedwait( &waitSet, nullptr, &ts );
+        }
+    }
