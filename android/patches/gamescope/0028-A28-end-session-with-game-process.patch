+    // The session is over when no guest image is left. Wine's own processes --
+    // the wrapper chain that started the game, explorer, services -- outlive the
+    // game, so waiting on the primary child alone would keep the session alive
+    // after it quits; the guest watch ignores them by living in drive_c/windows.
+    //
+    // An empty guest set alone is not an exit: a launcher hands off to a game
+    // image that may be differently named and may take a while to appear, and
+    // ending the session in that gap kills the game as it starts. The session's
+    // tree fingerprint separates the two cases -- a handoff keeps the tree
+    // moving, a finished session goes still.
+    static void WaitForSessionEnd( pid_t nPrimaryChild )
+    {
+        const int nIdlePollsToEnd = 8;   // 2 s of a still, guest-less session
+        bool bSeen = false;
+        int nIdlePolls = 0;
+        uint64_t nTreeStamp = 0;
+
+        while ( s_bRun )
+        {
+            int nStatus = 0;
+            pid_t nDeadChild = waitpid( nPrimaryChild, &nStatus, WNOHANG );
+            if ( nDeadChild == nPrimaryChild || ( nDeadChild == -1 && errno == ECHILD ) )
+                return;
+
+            if ( Process::IsGuestProcessRunning() )
+            {
+                bSeen = true;
+                nIdlePolls = 0;
+            }
+            else if ( bSeen )
+            {
+                // An empty guest set is not an exit on its own: a launcher may
+                // hand off to a differently named image, and on a slow title
+                // that gap outlasts any fixed window. A handoff keeps the
+                // session's process tree moving -- a fork here, an exit there --
+                // while a finished session goes still, so only a still tree is
+                // counted. An unreadable /proc (zero) keeps the flat window.
+                const uint64_t nStamp = Process::SessionTreeStamp( nPrimaryChild );
+                const bool bTreeMoved = nStamp != 0 && nStamp != nTreeStamp;
+                nTreeStamp = nStamp;
+
+                if ( bTreeMoved )
+                    nIdlePolls = 0;
+                else if ( ++nIdlePolls >= nIdlePollsToEnd )
+                {
+                    s_ReaperLog.infof( "No guest process left. Ending session." );
+                    return;
+                }
+            }
+
+            struct timespec ts{ 0, 250 * 1000 * 1000 };
+            nanosleep( &ts, nullptr );
+        }
+    }
