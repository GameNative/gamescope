+    // Case-insensitive comparison of two paths' final components, treating both
+    // '/' and '\\' as separators (Windows paths).
+    static bool BasenameEquals( const char *pszPath, const char *pszName )
+    {
+        auto basename = []( const char *pszValue ) -> const char *
+        {
+            const char *pszBase = pszValue;
+            for ( const char *p = pszValue; *p; p++ )
+            {
+                if ( *p == '/' || *p == '\\' )
+                    pszBase = p + 1;
+            }
+            return pszBase;
+        };
+
+        const char *pszBase = basename( pszPath );
+        const char *pszWant = basename( pszName );
+        return *pszBase && *pszWant && strcasecmp( pszBase, pszWant ) == 0;
+    }
+
+    // True when the command line names the guest image as the process's own
+    // program (argv[0]) or as wine's argument (argv[1]). Wine execs a guest as
+    // "<wine-loader> <guest-image> [args]", and depending on how the guest was
+    // started either slot holds its Windows path. Nothing deeper is examined:
+    // gamescope, the session reaper, and the top-level wine that starts
+    // explorer carry the guest path only in later arguments, so a wider match
+    // makes the reaper match its own command line whenever the launcher hands
+    // the guest exe straight to wine (Dave the Diver) and it then never sees
+    // the guest leave. The compare is case-insensitive because Windows paths are.
+    static bool ImageNameMatches( const char *pszCmdline, size_t nLength, const char *pszImageName )
+    {
+        if ( BasenameEquals( pszCmdline, pszImageName ) )
+            return true;
+
+        // argv[1] is the field after the first NUL, if it lies within the read data.
+        const char *pszNul = (const char *) memchr( pszCmdline, '\0', nLength );
+        if ( !pszNul || pszNul + 1 >= pszCmdline + nLength )
+            return false;
+
+        return BasenameEquals( pszNul + 1, pszImageName );
+    }
+
+    bool IsProcessImageRunning( const char *pszImageName )
+    {
+        DIR *pProcDir = opendir( "/proc" );
+        if ( !pProcDir )
+            return false;
+        defer( closedir( pProcDir ) );
+
+        struct dirent *pEntry;
+        while ( ( pEntry = readdir( pProcDir ) ) )
+        {
+            if ( pEntry->d_type != DT_DIR )
+                continue;
+
+            if ( !IsDigit( pEntry->d_name[0] ) )
+                continue;
+
+            char szPath[ PATH_MAX ];
+            snprintf( szPath, sizeof( szPath ), "/proc/%s/cmdline", pEntry->d_name );
+
+            FILE *pCmdlineFile = fopen( szPath, "r" );
+            if ( !pCmdlineFile )
+                continue;
+            defer( fclose( pCmdlineFile ) );
+
+            // cmdline is NUL-separated; keep the bytes and the read length so the
+            // matcher can walk argv[0]/argv[1] without over-reading.
+            char szCmdline[ PATH_MAX ] = {};
+            size_t nRead = fread( szCmdline, 1, sizeof( szCmdline ) - 1, pCmdlineFile );
+            szCmdline[ nRead ] = '\0';
+
+            if ( ImageNameMatches( szCmdline, nRead, pszImageName ) )
+                return true;
+        }
+
         return false;
     }
 
