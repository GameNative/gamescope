+    // The final component of a path, with both '/' and '\\' as separators
+    // (Windows paths in a wine command line).
+    static const char *Basename( const char *pszValue )
+    {
+        const char *pszBase = pszValue;
+        for ( const char *p = pszValue; *p; p++ )
+        {
+            if ( *p == '/' || *p == '\\' )
+                pszBase = p + 1;
+        }
+        return pszBase;
+    }
+
+    // Wine's own programs live in the prefix's windows directory.
+    static bool IsUnderWindowsDirectory( const char *pszValue )
+    {
+        for ( const char *p = pszValue; *p; p++ )
+        {
+            if ( strncasecmp( p, "windows\\", 8 ) == 0 || strncasecmp( p, "windows/", 8 ) == 0 )
+                return true;
+        }
+        return false;
+    }
+
+    // Where a bare image name resolves for the process `nPid`. Wine starts a
+    // child in the Unix directory that is its Windows current directory, and a
+    // program started by name alone is looked up there first (a launcher that
+    // runs "Game.exe" from the install directory, as Control's does); a name
+    // that is not there came from the system path, which is wine's own. The
+    // lookup ignores case, as the Windows lookup does. Empty when not found.
+    static std::string ResolveBareImage( pid_t nPid, const char *pszName )
+    {
+        char szLink[ 64 ];
+        snprintf( szLink, sizeof( szLink ), "/proc/%d/cwd", (int) nPid );
+
+        char szCwd[ PATH_MAX ];
+        ssize_t nLength = readlink( szLink, szCwd, sizeof( szCwd ) - 1 );
+        if ( nLength <= 0 )
+            return {};
+        szCwd[ nLength ] = '\0';
+
+        // The name as the launcher spelt it is almost always the name on disk.
+        std::string sExact = std::string( szCwd ) + "/" + pszName;
+        struct stat st;
+        if ( stat( sExact.c_str(), &st ) == 0 )
+            return S_ISDIR( st.st_mode ) ? std::string{} : sExact;
+
+        DIR *pDir = opendir( szCwd );
+        if ( !pDir )
+            return {};
+        defer( closedir( pDir ) );
+
+        struct dirent *pEntry;
+        while ( ( pEntry = readdir( pDir ) ) )
+        {
+            if ( pEntry->d_type == DT_DIR || strcasecmp( pEntry->d_name, pszName ) != 0 )
+                continue;
+            return std::string( szCwd ) + "/" + pEntry->d_name;
+        }
+        return {};
+    }
+
+    static bool IsGuestImage( pid_t nPid, const char *pszValue )
+    {
+        if ( !*pszValue || IsUnderWindowsDirectory( pszValue ) )
+            return false;
+
+        const char *pszBase = Basename( pszValue );
+        size_t nLength = strlen( pszBase );
+        if ( nLength <= 4 || strcasecmp( pszBase + nLength - 4, ".exe" ) != 0 )
+            return false;
+
+        // Started by path: the path says where the image lives. Started by
+        // name alone: the process's own directory says, or it was wine's.
+        if ( strpbrk( pszValue, "/\\" ) )
+            return true;
+
+        std::string sResolved = ResolveBareImage( nPid, pszValue );
+        return !sResolved.empty() && !IsUnderWindowsDirectory( sResolved.c_str() );
+    }
+
+    bool IsGuestProcess( pid_t nPid )
+    {
+        if ( nPid <= 0 )
+            return false;
+
+        char szPath[ 64 ];
+        snprintf( szPath, sizeof( szPath ), "/proc/%d/cmdline", (int) nPid );
+
+        FILE *pCmdlineFile = fopen( szPath, "r" );
+        if ( !pCmdlineFile )
+            return false;
+        defer( fclose( pCmdlineFile ) );
+
+        // cmdline is NUL-separated; keep the bytes and the read length so the
+        // matcher can walk argv[0]/argv[1] without over-reading.
+        char szCmdline[ PATH_MAX ] = {};
+        size_t nRead = fread( szCmdline, 1, sizeof( szCmdline ) - 1, pCmdlineFile );
+        szCmdline[ nRead ] = '\0';
+
+        if ( IsGuestImage( nPid, szCmdline ) )
+            return true;
+
+        const char *pszNul = (const char *) memchr( szCmdline, '\0', nRead );
+        return pszNul && pszNul + 1 < szCmdline + nRead && IsGuestImage( nPid, pszNul + 1 );
+    }
+
+    bool IsGuestProcessRunning()
+    {
+        DIR *pProcDir = opendir( "/proc" );
+        if ( !pProcDir )
+            return false;
+        defer( closedir( pProcDir ) );
+
+        struct dirent *pEntry;
+        while ( ( pEntry = readdir( pProcDir ) ) )
+        {
+            if ( pEntry->d_type != DT_DIR || !IsDigit( pEntry->d_name[0] ) )
+                continue;
+
+            if ( IsGuestProcess( (pid_t) strtol( pEntry->d_name, nullptr, 10 ) ) )
+                return true;
+        }
+
+        return false;
+    }
