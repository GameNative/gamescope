+    // The final component of a path, with both '/' and '\\' as separators
+    // (Windows paths in a wine command line).
+    static const char *Basename( const char *pszValue )
+    {
+        const char *pszBase = pszValue;
+        for ( const char *p = pszValue; *p; p++ )
+        {
+            if ( *p == '/' || *p == '\\' )
+                pszBase = p + 1;
+        }
+        return pszBase;
+    }
+
+    // Wine's own programs live in the prefix's windows directory.
+    static bool IsUnderWindowsDirectory( const char *pszValue )
+    {
+        for ( const char *p = pszValue; *p; p++ )
+        {
+            if ( strncasecmp( p, "windows\\", 8 ) == 0 || strncasecmp( p, "windows/", 8 ) == 0 )
+                return true;
+        }
+        return false;
+    }
+
+    static bool IsGuestImage( const char *pszValue )
+    {
+        if ( !*pszValue || IsUnderWindowsDirectory( pszValue ) )
+            return false;
+
+        // The guest is started by path; a bare image name is wine's own doing.
+        if ( !strpbrk( pszValue, "/\\" ) )
+            return false;
+
+        const char *pszBase = Basename( pszValue );
+        size_t nLength = strlen( pszBase );
+        return nLength > 4 && strcasecmp( pszBase + nLength - 4, ".exe" ) == 0;
+    }
+
+    bool IsGuestProcessRunning()
+    {
+        DIR *pProcDir = opendir( "/proc" );
+        if ( !pProcDir )
+            return false;
+        defer( closedir( pProcDir ) );
+
+        struct dirent *pEntry;
+        while ( ( pEntry = readdir( pProcDir ) ) )
+        {
+            if ( pEntry->d_type != DT_DIR )
+                continue;
+
+            if ( !IsDigit( pEntry->d_name[0] ) )
+                continue;
+
+            char szPath[ PATH_MAX ];
+            snprintf( szPath, sizeof( szPath ), "/proc/%s/cmdline", pEntry->d_name );
+
+            FILE *pCmdlineFile = fopen( szPath, "r" );
+            if ( !pCmdlineFile )
+                continue;
+            defer( fclose( pCmdlineFile ) );
+
+            // cmdline is NUL-separated; keep the bytes and the read length so the
+            // matcher can walk argv[0]/argv[1] without over-reading.
+            char szCmdline[ PATH_MAX ] = {};
+            size_t nRead = fread( szCmdline, 1, sizeof( szCmdline ) - 1, pCmdlineFile );
+            szCmdline[ nRead ] = '\0';
+
+            if ( IsGuestImage( szCmdline ) )
+                return true;
+
+            const char *pszNul = (const char *) memchr( szCmdline, '\0', nRead );
+            if ( pszNul && pszNul + 1 < szCmdline + nRead && IsGuestImage( pszNul + 1 ) )
+                return true;
+        }
+
+        return false;
+    }
