+    // The parent of `nPid`, from `/proc/<pid>/stat`. The comm field is in
+    // parentheses and may itself contain spaces and parentheses, so the parse
+    // starts at the last ')' — after it come `state` and then `ppid`.
+    static pid_t ParentPid( pid_t nPid )
+    {
+        char szPath[ 64 ];
+        snprintf( szPath, sizeof( szPath ), "/proc/%d/stat", (int) nPid );
+
+        FILE *pStatFile = fopen( szPath, "r" );
+        if ( !pStatFile )
+            return 0;
+        defer( fclose( pStatFile ) );
+
+        char szBuf[ 512 ];
+        size_t nRead = fread( szBuf, 1, sizeof( szBuf ) - 1, pStatFile );
+        szBuf[ nRead ] = '\0';
+
+        const char *pszClose = nullptr;
+        for ( size_t i = 0; i < nRead; i++ )
+        {
+            if ( szBuf[ i ] == ')' )
+                pszClose = szBuf + i;
+        }
+        if ( !pszClose )
+            return 0;
+
+        // " S 1234 ..." — skip the state character, then read the ppid.
+        const char *pszCursor = pszClose + 1;
+        while ( *pszCursor == ' ' )
+            pszCursor++;
+        if ( *pszCursor )
+            pszCursor++;
+        return (pid_t) strtol( pszCursor, nullptr, 10 );
+    }
+
+    uint64_t SessionTreeStamp( pid_t nRoot )
+    {
+        if ( nRoot <= 0 )
+            return 0;
+
+        DIR *pProcDir = opendir( "/proc" );
+        if ( !pProcDir )
+            return 0;
+        defer( closedir( pProcDir ) );
+
+        struct ProcessEntry { pid_t nPid; pid_t nParent; };
+        std::vector<ProcessEntry> entries;
+        std::vector<pid_t> sessionPids;
+
+        struct dirent *pEntry;
+        while ( ( pEntry = readdir( pProcDir ) ) )
+        {
+            if ( pEntry->d_type != DT_DIR || !IsDigit( pEntry->d_name[0] ) )
+                continue;
+
+            pid_t nPid = (pid_t) strtol( pEntry->d_name, nullptr, 10 );
+            if ( nPid <= 0 || nPid == nRoot )
+                continue;
+
+            entries.push_back( { nPid, ParentPid( nPid ) } );
+        }
+
+        // A process belongs to the session when its parent chain reaches the
+        // root within a bounded walk: a reparented descendant lands on the
+        // reaper, which is the root, so the chain is short in a live session.
+        // The lookups run off a copy sorted by pid, so a poll over the whole
+        // process table stays a few thousand comparisons.
+        std::vector<ProcessEntry> byPid = entries;
+        std::sort( byPid.begin(), byPid.end(), []( const ProcessEntry &a, const ProcessEntry &b ) {
+            return a.nPid < b.nPid;
+        } );
+
+        const auto parentOf = [ &byPid ]( pid_t nPid ) -> pid_t {
+            auto it = std::lower_bound( byPid.begin(), byPid.end(), nPid,
+                []( const ProcessEntry &entry, pid_t nValue ) { return entry.nPid < nValue; } );
+            return it != byPid.end() && it->nPid == nPid ? it->nParent : 0;
+        };
+
+        for ( const ProcessEntry &entry : entries )
+        {
+            pid_t nCursor = entry.nParent;
+            for ( int nHop = 0; nHop < 64 && nCursor > 1; nHop++ )
+            {
+                if ( nCursor == nRoot )
+                {
+                    sessionPids.push_back( entry.nPid );
+                    break;
+                }
+
+                pid_t nNext = parentOf( nCursor );
+                if ( nNext == 0 )
+                    break;
+                nCursor = nNext;
+            }
+        }
+
+        // Sorted, so the stamp depends on the set and not on readdir's order.
+        std::sort( sessionPids.begin(), sessionPids.end() );
+
+        // FNV-1a, 64-bit: the empty set still hashes to the offset basis, which
+        // is not zero, so zero stays reserved for "unreadable".
+        uint64_t nStamp = 1469598103934665603ull;
+        for ( pid_t nPid : sessionPids )
+        {
+            nStamp ^= (uint64_t) nPid;
+            nStamp *= 1099511628211ull;
+        }
+        return nStamp;
+    }
