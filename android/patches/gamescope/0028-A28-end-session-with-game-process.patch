+    // Cleared by the signal handler when the parent (gamescope) dies.
+    static bool s_bRun = true;
+
+    // The primary child is wine's wrapper chain (explorer -> winhandler), which
+    // outlives the game, so waiting on it alone would keep the session alive
+    // after the game quits. The launcher hands us the game's image name in
+    // GAMENATIVE_GAME_PROCESS; when set, end the session as soon as that process
+    // is gone -- but only after it has been seen once, so a game that has not
+    // started yet (or a pre-install step) never ends the session early, and only
+    // after two consecutive misses, so a process briefly between images is not
+    // mistaken for an exit. Without the name we fall back to the primary child.
+    static void WaitForSessionEnd( pid_t nPrimaryChild )
+    {
+        const char *pszGameImage = getenv( "GAMENATIVE_GAME_PROCESS" );
+        if ( !pszGameImage || !*pszGameImage )
+        {
+            Process::WaitForAllChildren( nPrimaryChild );
+            return;
+        }
+
+        bool bSeen = false;
+        int nMisses = 0;
+        while ( s_bRun )
+        {
+            int nStatus = 0;
+            pid_t nDeadChild = waitpid( nPrimaryChild, &nStatus, WNOHANG );
+            if ( nDeadChild == nPrimaryChild || ( nDeadChild == -1 && errno == ECHILD ) )
+                return;
+
+            if ( Process::IsProcessImageRunning( pszGameImage ) )
+            {
+                bSeen = true;
+                nMisses = 0;
+            }
+            else if ( bSeen && ++nMisses >= 2 )
+            {
+                s_ReaperLog.infof( "\"%s\" exited. Ending session.", pszGameImage );
+                return;
+            }
+
+            struct timespec ts{ 0, 250 * 1000 * 1000 };
+            nanosleep( &ts, nullptr );
+        }
+    }
