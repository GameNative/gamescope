+// The vblank timer re-armed itself after every wakeup, so the compositor thread woke at
+// the full grid rate for the whole session whether or not anything was pending: epoll,
+// X dispatch, the frame-callback walk over every window, presentation feedback and the
+// mangoapp publish, with only the composite skipped. It now stops after a few idle
+// wakeups and starts again on the next nudge (a commit, an X event, input, a flip).
+gamescope::ConVar<int> cv_vblank_idle_ticks( "vblank_idle_ticks", 2, "Vblank wakeups with nothing pending before the compositor stops waking on the vblank grid; it restarts on the next commit, input or command. 0 = wake on every vblank (old behaviour)." );
+
+// A window that has a done commit whose frame callback has not gone out yet: the
+// callback (or the limiter's release that lets it out) is only sent on a vblank wakeup.
+static bool steamcompmgr_any_window_owes_frame_done()
+{
+	gamescope_xwayland_server_t *server = NULL;
+	for ( size_t i = 0; ( server = wlserver_get_xwayland_server( i ) ); i++ )
+	{
+		for ( steamcompmgr_win_t *w = server->ctx->list; w; w = w->xwayland().next )
+		{
+			if ( w->receivedDoneCommit && w->current_surface() )
+				return true;
+		}
+
+		// Commits held for a later vblank (FIFO, or a desired present time ahead).
+		std::lock_guard<std::mutex> lock( server->ctx->doneCommits.listCommitsDoneLock );
+		if ( !server->ctx->doneCommits.listCommitsDone.empty() )
+			return true;
+	}
+
+	for ( const auto &xdg_win : g_steamcompmgr_xdg_wins )
+	{
+		if ( xdg_win->receivedDoneCommit && xdg_win->current_surface() )
+			return true;
+	}
+
+	std::lock_guard<std::mutex> lock( g_steamcompmgr_xdg_done_commits.listCommitsDoneLock );
+	return !g_steamcompmgr_xdg_done_commits.listCommitsDone.empty();
+}
