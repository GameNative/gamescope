+// The vblank a commit that is done now can first be shown on. The last wakeup's target
+// is that vblank while the timer runs on every vblank; after the compositor has been
+// idle (A54) it is in the past, and a commit's earliest present time and present margin
+// (earliest present - latch, unsigned) must not be taken from it.
+static uint64_t steamcompmgr_next_refresh_time()
+{
+	uint64_t ulTarget = g_SteamCompMgrVBlankTime.schedule.ulTargetVBlank;
+	if ( ulTarget < get_time_in_nanos() )
+		ulTarget = GetVBlankTimer().GetNextVBlank( 0 );
+	return ulTarget;
+}
