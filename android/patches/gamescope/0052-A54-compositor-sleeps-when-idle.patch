+static void steamcompmgr_rearm_vblank( bool bIsVBlankFromTimer, bool bVRR )
+{
+	const int nIdleTicks = cv_vblank_idle_ticks;
+	if ( nIdleTicks <= 0 )
+	{
+		// Old behaviour: re-arm after every timer wakeup, just in case the page-flip
+		// handler never comes, so we never stop vblanking.
+		if ( bIsVBlankFromTimer )
+			GetVBlankTimer().ArmNextVBlank( true );
+		return;
+	}
+
+	static int s_nIdleTicks = 0;
+	static bool s_bIdle = false;
+
+	if ( steamcompmgr_vblank_has_work( bVRR ) )
+		s_nIdleTicks = 0;
+	else if ( bIsVBlankFromTimer )
+		s_nIdleTicks++;
+
+	const bool bIdle = s_nIdleTicks >= nIdleTicks;
+	if ( !bIdle )
+	{
+		// Pre-emptive: a no-op while armed, so a nudge never moves a wakeup already set.
+		GetVBlankTimer().ArmNextVBlank( true );
+	}
+
+	if ( bIdle != s_bIdle )
+	{
+		s_bIdle = bIdle;
+		if ( gamescope::vblank_debug )
+		{
+			static uint64_t s_ulLastLog = 0;
+			static uint32_t s_uSuppressed = 0;
+			const uint64_t ulNow = get_time_in_nanos();
+			if ( ulNow - s_ulLastLog >= 100'000'000ul )
+			{
+				xwm_log.infof( "vblank: %s (%u transitions not logged)", bIdle ? "idle" : "resume", s_uSuppressed );
+				s_ulLastLog = ulNow;
+				s_uSuppressed = 0;
+			}
+			else
+			{
+				s_uSuppressed++;
+			}
+		}
+	}
+}
