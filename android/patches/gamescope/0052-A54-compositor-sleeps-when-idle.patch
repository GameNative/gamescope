+// Something the next vblank wakeup has to do: paint, finish a fade, send a frame
+// callback, see a flip retire, or hide an idle cursor when its time comes.
+static bool steamcompmgr_vblank_has_work( bool bVRR )
+{
+	if ( bVRR )
+		return true;
+
+	if ( hasRepaint || hasRepaintNonBasePlane || g_bForceRepaint || g_bUpdateForwardedVROverlays )
+		return true;
+
+	if ( is_any_focus_fading_out() )
+		return true;
+
+	if ( GetBackend()->GetCurrentConnector() &&
+		 GetBackend()->GetCurrentConnector()->PresentationFeedback().CurrentPresentsInFlight() != 0 )
+		return true;
+
+	if ( steamcompmgr_any_window_owes_frame_done() )
+		return true;
+
+	// A shown cursor auto-hides cursorHideTime after it last moved, checked on a wakeup;
+	// a little margin so the wakeup that hides it is never the one that stops.
+	if ( ShouldDrawCursor() && !wlserver.bCursorHidden && wlserver.bCursorHasImage )
+	{
+		static constexpr uint64_t k_ulCursorHideMargin = 100'000'000ul; // 100ms
+		if ( get_time_in_nanos() <= wlserver.ulLastMovedCursorTime + cursorHideTime + k_ulCursorHideMargin )
+			return true;
+	}
+
+#if HAVE_PIPEWIRE
+	if ( pipewire_is_streaming() )
+		return true;
+#endif
+
+	return false;
+}
