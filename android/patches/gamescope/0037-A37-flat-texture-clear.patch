+void CVulkanCmdBuffer::clearImage(gamescope::Rc<CVulkanTexture> dst, uint8_t r, uint8_t g, uint8_t b, uint8_t a)
+{
+	prepareDestImage(dst.get());
+	insertBarrier();
+	VkClearColorValue color = {
+		.float32 = { r / 255.0f, g / 255.0f, b / 255.0f, a / 255.0f },
+	};
+	VkImageSubresourceRange range = {
+		.aspectMask = VK_IMAGE_ASPECT_COLOR_BIT,
+		.levelCount = 1,
+		.layerCount = 1,
+	};
+
+	m_device->vk.CmdClearColorImage(m_cmdBuffer, dst->vkImage(), VK_IMAGE_LAYOUT_GENERAL, &color, 1, &range);
+
+	markDirty(dst.get());
+
+	m_textureRefs.emplace_back(std::move(dst));
+}
