+#if defined(__ANDROID__)
+    // gamenative A5: NDK r27 libc++ marks floating-point std::from_chars
+    // deleted; parse via strtod/strtof instead. Mirrors the generic template's
+    // semantics (no full-string consumption requirement, nullopt on error/range).
+    template <typename T>
+    inline std::optional<T> ParseFloatImpl( std::string_view chars );
+
+    template <>
+    inline std::optional<float> ParseFloatImpl<float>( std::string_view chars )
+    {
+        std::string str{ chars };
