+bool CVulkanDevice::hasDeviceExtension( const char *pszName ) const
+{
+	for ( const auto &ext : m_supportedExts )
+	{
+		if ( strcmp( ext.extensionName, pszName ) == 0 )
+			return true;
+	}
+	return false;
+}
+
+bool CVulkanDevice::createNullDescriptorFallback()
+{
+	if ( m_bNullDescriptor )
+		return true;
+
+	auto createPlaceholder = [this]( VkImageType eType, VkFormat eFormat, uint32_t uBytes, bool bStorage ) -> gamescope::OwningRc<CVulkanTexture>
+	{
+		CVulkanTexture::createFlags flags;
+		flags.bSampled = true;
+		flags.bStorage = bStorage;
+		flags.bTransferDst = true;
+		flags.imageType = eType;
+
+		gamescope::OwningRc<CVulkanTexture> pTexture = new CVulkanTexture();
+		if ( !pTexture->BInit( 1u, 1u, 1u, VulkanFormatToDRM( eFormat ), flags ) )
+			return nullptr;
+
+		auto [pDst, uOffset] = uploadBufferData( uBytes );
+		memset( pDst, 0, uBytes );
+
+		auto cmdBuffer = commandBuffer();
+		cmdBuffer->copyBufferToImage( uploadBuffer(), uOffset, 0, pTexture.get() );
+		submit( std::move( cmdBuffer ) );
+		return pTexture;
+	};
+
+	m_pNullTexture2D = createPlaceholder( VK_IMAGE_TYPE_2D, VK_FORMAT_R8G8B8A8_UNORM, 4, true );
+	m_pNullTexture1D = createPlaceholder( VK_IMAGE_TYPE_1D, VK_FORMAT_R16G16B16A16_UNORM, 8, false );
+	m_pNullTexture3D = createPlaceholder( VK_IMAGE_TYPE_3D, VK_FORMAT_R16G16B16A16_UNORM, 8, false );
+	if ( m_pNullTexture2D == nullptr || m_pNullTexture1D == nullptr || m_pNullTexture3D == nullptr )
+	{
+		vk_log.errorf( "failed to create the placeholder images for empty descriptor slots" );
+		return false;
+	}
+
+	if ( !m_bNoImmutableYcbcr )
+	{
+		VkFormatProperties nv12Properties;
+		vk.GetPhysicalDeviceFormatProperties( physDev(), VK_FORMAT_G8_B8R8_2PLANE_420_UNORM, &nv12Properties );
+		VkResult res = ( nv12Properties.optimalTilingFeatures & VK_FORMAT_FEATURE_SAMPLED_IMAGE_BIT ) ? VK_SUCCESS : VK_ERROR_FORMAT_NOT_SUPPORTED;
+
+		if ( res == VK_SUCCESS )
+		{
+			VkImageCreateInfo imageInfo = {
+				.sType = VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO,
+				.imageType = VK_IMAGE_TYPE_2D,
+				.format = VK_FORMAT_G8_B8R8_2PLANE_420_UNORM,
+				.extent = { 2, 2, 1 },
+				.mipLevels = 1,
+				.arrayLayers = 1,
+				.samples = VK_SAMPLE_COUNT_1_BIT,
+				.tiling = VK_IMAGE_TILING_OPTIMAL,
+				.usage = VK_IMAGE_USAGE_SAMPLED_BIT,
+				.sharingMode = VK_SHARING_MODE_EXCLUSIVE,
+				.initialLayout = VK_IMAGE_LAYOUT_UNDEFINED,
+			};
+			res = vk.CreateImage( device(), &imageInfo, nullptr, &m_nullYcbcrImage );
+		}
+
+		if ( res == VK_SUCCESS )
+		{
+			VkMemoryRequirements memReqs;
+			vk.GetImageMemoryRequirements( device(), m_nullYcbcrImage, &memReqs );
+			int32_t memType = findMemoryType( VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT, memReqs.memoryTypeBits );
+			VkMemoryAllocateInfo allocInfo = {
+				.sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO,
+				.allocationSize = memReqs.size,
+				.memoryTypeIndex = uint32_t( memType ),
+			};
+			res = memType < 0 ? VK_ERROR_OUT_OF_DEVICE_MEMORY : vk.AllocateMemory( device(), &allocInfo, nullptr, &m_nullYcbcrMemory );
+			if ( res == VK_SUCCESS )
+				res = vk.BindImageMemory( device(), m_nullYcbcrImage, m_nullYcbcrMemory, 0 );
+		}
+
+		if ( res == VK_SUCCESS )
+		{
+			VkSamplerYcbcrConversionInfo conversionInfo = {
+				.sType = VK_STRUCTURE_TYPE_SAMPLER_YCBCR_CONVERSION_INFO,
+				.conversion = m_ycbcrConversion,
+			};
+			VkImageViewCreateInfo viewInfo = {
+				.sType = VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO,
+				.pNext = &conversionInfo,
+				.image = m_nullYcbcrImage,
+				.viewType = VK_IMAGE_VIEW_TYPE_2D,
+				.format = VK_FORMAT_G8_B8R8_2PLANE_420_UNORM,
+				.subresourceRange = {
+					.aspectMask = VK_IMAGE_ASPECT_COLOR_BIT,
+					.levelCount = 1,
+					.layerCount = 1,
+				},
+			};
+			res = vk.CreateImageView( device(), &viewInfo, nullptr, &m_nullYcbcrView );
+		}
+
+		if ( res == VK_SUCCESS )
+		{
+			VkImageMemoryBarrier barrier = {
+				.sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER,
+				.dstAccessMask = VK_ACCESS_SHADER_READ_BIT,
+				.oldLayout = VK_IMAGE_LAYOUT_UNDEFINED,
+				.newLayout = VK_IMAGE_LAYOUT_GENERAL,
+				.srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+				.dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+				.image = m_nullYcbcrImage,
+				.subresourceRange = {
+					.aspectMask = VK_IMAGE_ASPECT_COLOR_BIT,
+					.levelCount = 1,
+					.layerCount = 1,
+				},
+			};
+			auto cmdBuffer = commandBuffer();
+			vk.CmdPipelineBarrier( cmdBuffer->rawBuffer(), VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT,
+				0, 0, nullptr, 0, nullptr, 1, &barrier );
+			submit( std::move( cmdBuffer ) );
+		}
+		else
+		{
+			vk_log.infof( "no NV12 placeholder image (VkResult %d), YCbCr slots get the RGBA placeholder", res );
+			if ( m_nullYcbcrImage != VK_NULL_HANDLE )
+				vk.DestroyImage( device(), m_nullYcbcrImage, nullptr );
+			if ( m_nullYcbcrMemory != VK_NULL_HANDLE )
+				vk.FreeMemory( device(), m_nullYcbcrMemory, nullptr );
+			m_nullYcbcrImage = VK_NULL_HANDLE;
+			m_nullYcbcrMemory = VK_NULL_HANDLE;
+		}
+	}
+
+	waitIdle();
+	return true;
+}
+
+VkImageView CVulkanDevice::nullImageView( VkImageViewType eViewType )
+{
+	if ( m_bNullDescriptor )
+		return VK_NULL_HANDLE;
+
+	switch ( eViewType )
+	{
+		case VK_IMAGE_VIEW_TYPE_1D: return m_pNullTexture1D->srgbView();
+		case VK_IMAGE_VIEW_TYPE_3D: return m_pNullTexture3D->srgbView();
+		default: return m_pNullTexture2D->srgbView();
+	}
+}
+
+VkImageView CVulkanDevice::nullYcbcrImageView()
+{
+	if ( m_bNullDescriptor )
+		return VK_NULL_HANDLE;
+
+	if ( !m_bNoImmutableYcbcr && m_nullYcbcrView != VK_NULL_HANDLE )
+		return m_nullYcbcrView;
+
+	return m_pNullTexture2D->srgbView();
+}
