+bool CVulkanDevice::growUploadBuffer( uint32_t required )
+{
+	// Only reachable when the output turns out bigger than the size the host
+	// asked for up front (the DRM mode is picked after this device is built).
+	// Wait for everything submitted before swapping the buffer out, and retire
+	// the old one instead of destroying it: a command buffer may still be
+	// recording a copy out of it — uploadConstants stages from inside a
+	// recording buffer — and this device has no destruction queue to hand it
+	// to. Growth doubles, so the list stays short, and with the initial size
+	// right it never grows at all.
+	waitIdle( true );
+
+	const uint32_t uNeeded = align( required, 1024u * 1024u );
+	uint32_t newSize = upload_buffer_size > 0 ? upload_buffer_size : 1024u * 1024u;
+	while ( newSize < uNeeded )
+		newSize *= 2;
+
+	m_retiredUploadBuffers.emplace_back( m_uploadBuffer, m_uploadBufferMemory );
+	m_uploadBuffer = VK_NULL_HANDLE;
+	m_uploadBufferMemory = VK_NULL_HANDLE;
+	m_uploadBufferData = nullptr;
+
+	if ( !createUploadBuffer( newSize ) )
+	{
+		vk_log.errorf( "growUploadBuffer: could not grow the upload buffer to %u bytes", newSize );
 		return false;
 	}
 
