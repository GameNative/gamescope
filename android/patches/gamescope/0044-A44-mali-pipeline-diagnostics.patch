+		VkSamplerYcbcrConversionCreateInfo conversionInfo = makeYcbcrConversionInfo( nv12Properties.optimalTilingFeatures & VK_FORMAT_FEATURE_COSITED_CHROMA_SAMPLES_BIT );
+		res = pfnCreateSamplerYcbcrConversion( dev, &conversionInfo, nullptr, &conversion );
+		if ( res != VK_SUCCESS )
+		{
+			snprintf( name, sizeof(name), "%s_ycbcr_conversion", probeName );
+			log_probe( name, res );
+			break;
+		}
+
+		VkSamplerYcbcrConversionInfo samplerConversionInfo = {
+			.sType = VK_STRUCTURE_TYPE_SAMPLER_YCBCR_CONVERSION_INFO,
+			.conversion = conversion,
+		};
+		VkSamplerCreateInfo samplerInfo = makeYcbcrSamplerInfo( &samplerConversionInfo );
+		res = pfnCreateSampler( dev, &samplerInfo, nullptr, &sampler );
+		if ( res != VK_SUCCESS )
+		{
+			snprintf( name, sizeof(name), "%s_ycbcr_sampler", probeName );
+			log_probe( name, res );
+			break;
+		}
+
+		std::array<VkSampler, VKR_SAMPLER_SLOTS> samplers;
+		samplers.fill( sampler );
+		std::array<VkDescriptorSetLayoutBinding, 7> bindings = makeLayoutBindings( samplers.data() );
+		VkDescriptorSetLayoutCreateInfo setLayoutInfo = {
+			.sType = VK_STRUCTURE_TYPE_DESCRIPTOR_SET_LAYOUT_CREATE_INFO,
+			.bindingCount = uint32_t(bindings.size()),
+			.pBindings = bindings.data(),
+		};
+		res = pfnCreateDescriptorSetLayout( dev, &setLayoutInfo, nullptr, &setLayout );
+		if ( res != VK_SUCCESS )
+		{
+			snprintf( name, sizeof(name), "%s_set_layout", probeName );
+			log_probe( name, res );
+			break;
+		}
+
+		VkPipelineLayoutCreateInfo pipelineLayoutInfo = {
+			.sType = VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO,
+			.setLayoutCount = 1,
+			.pSetLayouts = &setLayout,
+		};
+		res = pfnCreatePipelineLayout( dev, &pipelineLayoutInfo, nullptr, &pipelineLayout );
