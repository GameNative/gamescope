+		if ( res != VK_SUCCESS )
+		{
+			snprintf( name, sizeof(name), "%s_shader_module", probeName );
+			log_probe( name, res );
+			break;
+		}
+
+		log_probe( probeName, probeComputePipeline( dev, pfnCreateComputePipelines, pfnDestroyPipeline, module, pipelineLayout ) );
+	} while ( false );
