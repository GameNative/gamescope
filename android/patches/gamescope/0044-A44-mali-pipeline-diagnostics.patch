+	if ( module )
+		pfnDestroyShaderModule( dev, module, nullptr );
+	if ( pipelineLayout )
+		pfnDestroyPipelineLayout( dev, pipelineLayout, nullptr );
+	if ( setLayout )
+		pfnDestroyDescriptorSetLayout( dev, setLayout, nullptr );
+	if ( sampler )
+		pfnDestroySampler( dev, sampler, nullptr );
+	if ( conversion )
+		pfnDestroySamplerYcbcrConversion( dev, conversion, nullptr );
+	pfnDestroyDevice( dev, nullptr );
 }
 
