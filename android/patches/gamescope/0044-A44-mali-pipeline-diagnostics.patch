+static VkResult probeComputePipeline( VkDevice dev, PFN_vkCreateComputePipelines pfnCreate, PFN_vkDestroyPipeline pfnDestroy, VkShaderModule module, VkPipelineLayout layout )
+{
+	const uint32_t specData[7] = { 1, 0, 0, 1, 0, 0, 0 };
+	std::array<VkSpecializationMapEntry, 7> specEntries;
+	for ( uint32_t i = 0; i < specEntries.size(); i++ )
+		specEntries[i] = { .constantID = i, .offset = uint32_t(sizeof(uint32_t) * i), .size = sizeof(uint32_t) };
+
+	VkSpecializationInfo specInfo = {
+		.mapEntryCount = uint32_t(specEntries.size()),
+		.pMapEntries = specEntries.data(),
+		.dataSize = sizeof(specData),
+		.pData = specData,
+	};
+
+	VkComputePipelineCreateInfo createInfo = {
+		.sType = VK_STRUCTURE_TYPE_COMPUTE_PIPELINE_CREATE_INFO,
+		.stage = {
+			.sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO,
+			.stage = VK_SHADER_STAGE_COMPUTE_BIT,
+			.module = module,
+			.pName = "main",
+			.pSpecializationInfo = &specInfo,
+		},
+		.layout = layout,
+	};
+
+	VkPipeline pipeline = VK_NULL_HANDLE;
+	VkResult res = pfnCreate( dev, VK_NULL_HANDLE, 1, &createInfo, nullptr, &pipeline );
+	if ( res == VK_SUCCESS && pipeline != VK_NULL_HANDLE )
+		pfnDestroy( dev, pipeline, nullptr );
+	return res;
+}
+
+void CVulkanDevice::runPipelineProbes()
+{
+	auto pfnGetLayoutSupport = (PFN_vkGetDescriptorSetLayoutSupport) vk.GetDeviceProcAddr( device(), "vkGetDescriptorSetLayoutSupport" );
+	auto pfnDestroyShaderModule = (PFN_vkDestroyShaderModule) vk.GetDeviceProcAddr( device(), "vkDestroyShaderModule" );
+
+	std::array<VkSampler, VKR_SAMPLER_SLOTS> ycbcrSamplers;
+	ycbcrSamplers.fill( m_ycbcrSampler );
+	std::array<VkDescriptorSetLayoutBinding, 7> fullBindings = makeLayoutBindings( ycbcrSamplers.data() );
+	std::array<VkDescriptorSetLayoutBinding, 7> plainBindings = makeLayoutBindings( nullptr );
+
+	std::array<VkDescriptorSetLayoutBinding, 3> minimalBindings = {
+		VkDescriptorSetLayoutBinding { .binding = 0, .descriptorType = VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER, .descriptorCount = 1, .stageFlags = VK_SHADER_STAGE_COMPUTE_BIT },
+		VkDescriptorSetLayoutBinding { .binding = 1, .descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_IMAGE, .descriptorCount = 1, .stageFlags = VK_SHADER_STAGE_COMPUTE_BIT },
+		VkDescriptorSetLayoutBinding { .binding = 3, .descriptorType = VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER, .descriptorCount = 1, .stageFlags = VK_SHADER_STAGE_COMPUTE_BIT },
+	};
+	std::array<VkDescriptorSetLayoutBinding, 4> minimalYcbcrBindings = {
+		minimalBindings[0], minimalBindings[1], minimalBindings[2],
+		VkDescriptorSetLayoutBinding { .binding = 4, .descriptorType = VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER, .descriptorCount = 1, .stageFlags = VK_SHADER_STAGE_COMPUTE_BIT, .pImmutableSamplers = &m_ycbcrSampler },
+	};
+
+	struct ProbeLayout
+	{
+		const char *name;
+		const VkDescriptorSetLayoutBinding *pBindings;
+		uint32_t uBindingCount;
+		VkDescriptorSetLayout setLayout = VK_NULL_HANDLE;
+		VkPipelineLayout pipelineLayout = VK_NULL_HANDLE;
+	};
+	std::array<ProbeLayout, 4> layouts = {
+		ProbeLayout { "full", fullBindings.data(), uint32_t(fullBindings.size()) },
+		ProbeLayout { "no_immutable_ycbcr", plainBindings.data(), uint32_t(plainBindings.size()) },
+		ProbeLayout { "minimal", minimalBindings.data(), uint32_t(minimalBindings.size()) },
+		ProbeLayout { "minimal_1ycbcr", minimalYcbcrBindings.data(), uint32_t(minimalYcbcrBindings.size()) },
+	};
+
+	char name[128];
+	for ( auto &layout : layouts )
+	{
+		VkDescriptorSetLayoutCreateInfo setLayoutInfo = {
+			.sType = VK_STRUCTURE_TYPE_DESCRIPTOR_SET_LAYOUT_CREATE_INFO,
+			.bindingCount = layout.uBindingCount,
+			.pBindings = layout.pBindings,
+		};
+
+		if ( pfnGetLayoutSupport )
+		{
+			VkDescriptorSetLayoutSupport support = {
+				.sType = VK_STRUCTURE_TYPE_DESCRIPTOR_SET_LAYOUT_SUPPORT,
+			};
+			pfnGetLayoutSupport( device(), &setLayoutInfo, &support );
+			fprintf( stderr, "[gamescope] probe layout_support_%s: supported %u\n", layout.name, support.supported );
+		}
+
+		VkResult res = vk.CreateDescriptorSetLayout( device(), &setLayoutInfo, nullptr, &layout.setLayout );
+		snprintf( name, sizeof(name), "set_layout_%s", layout.name );
+		log_probe( name, res );
+		if ( res != VK_SUCCESS )
+		{
+			layout.setLayout = VK_NULL_HANDLE;
+			continue;
+		}
+
+		VkPipelineLayoutCreateInfo pipelineLayoutInfo = {
+			.sType = VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO,
+			.setLayoutCount = 1,
+			.pSetLayouts = &layout.setLayout,
+		};
+		res = vk.CreatePipelineLayout( device(), &pipelineLayoutInfo, nullptr, &layout.pipelineLayout );
+		snprintf( name, sizeof(name), "pipeline_layout_%s", layout.name );
+		log_probe( name, res );
+		if ( res != VK_SUCCESS )
+			layout.pipelineLayout = VK_NULL_HANDLE;
+	}
+
+	auto createModule = [&]( const char *moduleName, const uint32_t *pCode, size_t size ) -> VkShaderModule
+	{
+		VkShaderModuleCreateInfo moduleInfo = {
+			.sType = VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO,
+			.codeSize = size,
+			.pCode = pCode,
+		};
+		VkShaderModule module = VK_NULL_HANDLE;
+		VkResult res = vk.CreateShaderModule( device(), &moduleInfo, nullptr, &module );
+		snprintf( name, sizeof(name), "shader_module_%s", moduleName );
+		log_probe( name, res );
+		return res == VK_SUCCESS ? module : VK_NULL_HANDLE;
+	};
+
+	VkShaderModule trivialModule = createModule( "trivial", cs_probe_trivial, sizeof(cs_probe_trivial) );
+	VkShaderModule scalarModule = createModule( "scalar_ubo", cs_probe_scalar, sizeof(cs_probe_scalar) );
+	VkShaderModule blitModule = m_shaderModules[SHADER_TYPE_BLIT];
+
+	struct PipelineProbe
+	{
+		const char *name;
+		VkShaderModule module;
+		VkPipelineLayout layout;
+	};
+	const std::array<PipelineProbe, 8> probes = {
+		PipelineProbe { "trivial_device_layout", trivialModule, m_pipelineLayout },
+		PipelineProbe { "trivial_full_layout", trivialModule, layouts[0].pipelineLayout },
+		PipelineProbe { "trivial_minimal_layout", trivialModule, layouts[2].pipelineLayout },
+		PipelineProbe { "trivial_minimal_1ycbcr_layout", trivialModule, layouts[3].pipelineLayout },
+		PipelineProbe { "scalar_ubo_minimal_layout", scalarModule, layouts[2].pipelineLayout },
+		PipelineProbe { "scalar_ubo_full_layout", scalarModule, layouts[0].pipelineLayout },
+		PipelineProbe { "blit_full_layout", blitModule, layouts[0].pipelineLayout },
+		PipelineProbe { "blit_no_immutable_ycbcr", blitModule, layouts[1].pipelineLayout },
+	};
+
+	for ( const auto &probe : probes )
+	{
+		if ( probe.module == VK_NULL_HANDLE || probe.layout == VK_NULL_HANDLE )
+		{
+			fprintf( stderr, "[gamescope] probe %s: skipped (module %s, layout %s)\n", probe.name,
+				probe.module ? "ok" : "NULL", probe.layout ? "ok" : "NULL" );
+			continue;
+		}
+		log_probe( probe.name, probeComputePipeline( device(), vk.CreateComputePipelines, vk.DestroyPipeline, probe.module, probe.layout ) );
+	}
+
+	if ( pfnDestroyShaderModule )
