+void CVulkanDevice::logDeviceLimits()
+{
+	VkPhysicalDeviceDriverProperties driverProps = {
+		.sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_DRIVER_PROPERTIES,
+	};
+	VkPhysicalDeviceMaintenance3Properties maintenance3Props = {
+		.sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_MAINTENANCE_3_PROPERTIES,
+		.pNext = &driverProps,
+	};
+	VkPhysicalDeviceProperties2 props2 = {
+		.sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_PROPERTIES_2,
+		.pNext = &maintenance3Props,
+	};
+	vk.GetPhysicalDeviceProperties2( physDev(), &props2 );
+	const VkPhysicalDeviceProperties &props = props2.properties;
+	const VkPhysicalDeviceLimits &l = props.limits;
+
+	VkPhysicalDeviceVulkan12Features features12 = {
+		.sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VULKAN_1_2_FEATURES,
+	};
+	VkPhysicalDeviceVulkan11Features features11 = {
+		.sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VULKAN_1_1_FEATURES,
+		.pNext = &features12,
+	};
+	VkPhysicalDeviceFeatures2 features2 = {
+		.sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_FEATURES_2,
+		.pNext = &features11,
+	};
+	vk.GetPhysicalDeviceFeatures2( physDev(), &features2 );
+
+	fprintf(stderr, "[gamescope] limits: device=\"%s\" vendorID=0x%04x deviceID=0x%04x api=%u.%u.%u driverVersion=0x%08x driverID=%d driverName=\"%s\" driverInfo=\"%s\"\n",
+		props.deviceName, props.vendorID, props.deviceID,
+		VK_API_VERSION_MAJOR(props.apiVersion), VK_API_VERSION_MINOR(props.apiVersion), VK_API_VERSION_PATCH(props.apiVersion),
+		props.driverVersion, (int)driverProps.driverID, driverProps.driverName, driverProps.driverInfo);
+	fprintf(stderr, "[gamescope] limits: maxPerStageDescriptorSamplers=%u maxPerStageDescriptorSampledImages=%u maxPerStageDescriptorStorageImages=%u maxPerStageDescriptorUniformBuffers=%u maxPerStageResources=%u maxDescriptorSetSamplers=%u maxDescriptorSetSampledImages=%u maxDescriptorSetStorageImages=%u maxBoundDescriptorSets=%u maxPerSetDescriptors=%u maxComputeWorkGroupInvocations=%u maxComputeWorkGroupSize=%ux%ux%u maxComputeSharedMemorySize=%u maxUniformBufferRange=%u\n",
+		l.maxPerStageDescriptorSamplers, l.maxPerStageDescriptorSampledImages, l.maxPerStageDescriptorStorageImages, l.maxPerStageDescriptorUniformBuffers,
+		l.maxPerStageResources, l.maxDescriptorSetSamplers, l.maxDescriptorSetSampledImages, l.maxDescriptorSetStorageImages, l.maxBoundDescriptorSets,
+		maintenance3Props.maxPerSetDescriptors, l.maxComputeWorkGroupInvocations,
+		l.maxComputeWorkGroupSize[0], l.maxComputeWorkGroupSize[1], l.maxComputeWorkGroupSize[2],
+		l.maxComputeSharedMemorySize, l.maxUniformBufferRange);
+	fprintf(stderr, "[gamescope] limits: features scalarBlockLayout=%u samplerYcbcrConversion=%u shaderFloat16=%u shaderInt16=%u uniformBufferStandardLayout=%u shaderStorageImageWriteWithoutFormat=%u\n",
+		features12.scalarBlockLayout, features11.samplerYcbcrConversion, features12.shaderFloat16, features2.features.shaderInt16,
+		features12.uniformBufferStandardLayout, features2.features.shaderStorageImageWriteWithoutFormat);
+	fflush(stderr);
+}
