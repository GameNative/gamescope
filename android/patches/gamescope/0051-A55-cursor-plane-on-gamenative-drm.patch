+			m_bWasPartialCompositing = false;
+			m_pCompositeUnderCursor = pComposite;
+
+			const uint64_t ulTotal = m_ulCursorPlaneComposites + m_ulCursorPlaneReuses;
+			if ( ulTotal == 1 || ulTotal % 3600 == 0 )
