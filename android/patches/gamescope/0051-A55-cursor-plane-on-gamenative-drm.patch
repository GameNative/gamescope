+// A55: cursor-plane repaints. Like hasRepaint, a motion is a repaint request the
+// next vblank picks up; unlike it, it says only the cursor changed. Every motion
+// bumps the serial and a paint records the serial it painted, so a motion that
+// lands during a paint is still pending after it instead of being cleared with it.
+std::atomic<bool> g_bCursorOnPlane{ false };
+static std::atomic<uint64_t> g_ulCursorRepaintSerial{ 0 };
+static uint64_t s_ulCursorRepaintPainted = 0;
+// Set for the paint_all call of a paint whose only cause is a cursor motion.
+static bool g_bPaintIsCursorOnly = false;
+
+void request_cursor_repaint( void )
+{
+	g_ulCursorRepaintSerial.fetch_add( 1, std::memory_order_relaxed );
+}
