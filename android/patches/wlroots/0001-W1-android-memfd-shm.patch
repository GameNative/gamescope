android: W1 — memfd-based shm for bionic (no shm_open/shm_unlink)

bionic lacks POSIX shm entirely and memfd_create() is only declared from
API 30; we target 28. Use raw SYS_memfd_create + /proc/self/fd re-open for
allocate_shm_file()/allocate_shm_file_pair() under __ANDROID__; unused
shm_open helpers compiled out. No new dependencies.

---
diff --git a/util/shm.c b/util/shm.c
--- a/util/shm.c
+++ b/util/shm.c
@@ -8,8 +8,19 @@
 #include <wlr/config.h>
 #include "util/shm.h"
 
+// gamenative W1: bionic has no shm_open/shm_unlink (POSIX shm); use memfd via
+// raw syscall (memfd_create() is only declared by bionic from API 30).
+#if defined(__ANDROID__)
+#include <stdio.h>
+#include <sys/syscall.h>
+#ifndef MFD_CLOEXEC
+#define MFD_CLOEXEC 0x0001U
+#endif
+#endif
+
 #define RANDNAME_PATTERN "/wlroots-XXXXXX"
 
+#if !defined(__ANDROID__)
 static void randname(char *buf) {
 	struct timespec ts;
 	clock_gettime(CLOCK_REALTIME, &ts);
@@ -35,14 +46,22 @@
 
 	return -1;
 }
+#endif // !__ANDROID__
 
 int allocate_shm_file(size_t size) {
+#if defined(__ANDROID__)
+	int fd = syscall(SYS_memfd_create, "wlroots", MFD_CLOEXEC);
+	if (fd < 0) {
+		return -1;
+	}
+#else
 	char name[] = RANDNAME_PATTERN;
 	int fd = excl_shm_open(name);
 	if (fd < 0) {
 		return -1;
 	}
 	shm_unlink(name);
+#endif
 
 	int ret;
 	do {
@@ -57,6 +76,22 @@
 }
 
 bool allocate_shm_file_pair(size_t size, int *rw_fd_ptr, int *ro_fd_ptr) {
+#if defined(__ANDROID__)
+	int rw_fd = syscall(SYS_memfd_create, "wlroots", MFD_CLOEXEC);
+	if (rw_fd < 0) {
+		return false;
+	}
+
+	// memfd has no name to re-open, and Android denies an app-domain process
+	// the open() of a /proc/self/fd link that points at an anonymous memfd
+	// (EACCES). dup() gives the same underlying file, which is all any caller
+	// uses the read-only fd for.
+	int ro_fd = dup(rw_fd);
+	if (ro_fd < 0) {
+		close(rw_fd);
+		return false;
+	}
+#else
 	char name[] = RANDNAME_PATTERN;
 	int rw_fd = excl_shm_open(name);
 	if (rw_fd < 0) {
@@ -72,14 +107,24 @@
 	}
 
 	shm_unlink(name);
+#endif
 
+#if !defined(__ANDROID__)
 	// Make sure the file cannot be re-opened in read-write mode (e.g. via
 	// "/proc/self/fd/" on Linux)
+	//
+	// bionic/Android refuses fchmod() on a memfd (EACCES), so this hardening
+	// step does not exist there; it is also moot for the pair above, whose two
+	// fds are the same file description. What it protected against — a client
+	// re-opening the keymap buffer read-write — is denied on Android twice
+	// over, by the /proc/self/fd open() denial and by the dup() being the only
+	// way in.
 	if (fchmod(rw_fd, 0) != 0) {
 		close(rw_fd);
 		close(ro_fd);
 		return false;
 	}
+#endif
 
